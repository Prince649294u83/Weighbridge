<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WeighBridge.Tests</RootNamespace>
    <AssemblyName>WeighBridge.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WeighBridge.Core\WeighBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Domain\WeighBridge.Domain.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Hardware\WeighBridge.Hardware.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Infrastructure\WeighBridge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Printing\WeighBridge.Printing.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Reporting\WeighBridge.Reporting.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Services\WeighBridge.Services.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.Settings\WeighBridge.Settings.csproj" />
    <ProjectReference Include="..\..\src\WeighBridge.App\WeighBridge.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
