<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WeighBridge.Printing
    Slip / ticket printing layer. Module 0.1 ships a disconnected placeholder that
    reports printer availability to the status bar.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WeighBridge.Printing</RootNamespace>
    <AssemblyName>WeighBridge.Printing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeighBridge.Core\WeighBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
