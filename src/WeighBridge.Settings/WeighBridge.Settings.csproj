<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WeighBridge.Settings
    Owns the on-disk application data root: creating appsettings.json with defaults
    when it is missing, and persisting user preferences (theme, window placement,
    last visited module) as JSON via System.Text.Json.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WeighBridge.Settings</RootNamespace>
    <AssemblyName>WeighBridge.Settings</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeighBridge.Core\WeighBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
