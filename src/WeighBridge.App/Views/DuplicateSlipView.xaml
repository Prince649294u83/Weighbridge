<UserControl x:Class="WeighBridge.App.Views.DuplicateSlipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:DuplicateSlipViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             mc:Ignorable="d">

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />

    <Style x:Key="StatusLine.Accent" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Default}" />
      <Setter Property="CornerRadius" Value="2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Information">
          <Setter Property="Background" Value="{DynamicResource Brush.Info.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
          <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource Brush.Warning.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Danger">
          <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Field.Label"
           BasedOn="{StaticResource Text.Label}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.DuplicateSlip}"
                            ShowSeparator="True"
                            Title="{Binding Title}" />

    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  Search Criteria  -->
      <ScrollViewer Grid.Column="0"
                    Style="{StaticResource ScrollViewer.Default}"
                    VerticalScrollBarVisibility="Auto">
        <controls:ModernCard Header="Search"
                             Icon="{StaticResource Icon.Search}"
                             SubHeader="Find completed weighments">
          <StackPanel>
            <TextBlock Style="{StaticResource Field.Label}" Text="Search term" />
            <TextBox AutomationProperties.Name="Search by slip, vehicle, or party"
                     Style="{StaticResource TextBox.Default}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Start date" />
            <DatePicker SelectedDate="{Binding StartDate}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="End date" />
            <DatePicker SelectedDate="{Binding EndDate}" />

            <StackPanel Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button Command="{Binding ClearCommand}"
                      Content="Clear"
                      Style="{StaticResource Button.Text}" />
              <Button Margin="10,0,0,0"
                      Command="{Binding SearchCommand}"
                      Content="Search"
                      Style="{StaticResource Button.Primary}" />
            </StackPanel>
          </StackPanel>
        </controls:ModernCard>
      </ScrollViewer>

      <!--  Search Results  -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Status line  -->
        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{StaticResource Radius.MD}"
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding HasStatus, Converter={StaticResource Converter.BooleanToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusLine.Accent}" />

            <TextBlock Grid.Column="1"
                       Margin="14,10,14,10"
                       Style="{StaticResource Text.Body.Wrapped}"
                       Text="{Binding StatusMessage}" />
          </Grid>
        </Border>

        <controls:ModernCard Grid.Row="1"
                             Header="Search Results"
                             Icon="{StaticResource Icon.Database}"
                             SubHeader="Select a weighment to reprint its slip">
            <controls:ModernCard.HeaderActions>
                <Button Command="{Binding ReprintCommand}"
                        CommandParameter="{Binding SelectedWeighment}"
                        Content="Reprint slip"
                        Style="{StaticResource Button.Primary}" />
            </controls:ModernCard.HeaderActions>
            
          <Grid>
            <DataGrid AutomationProperties.Name="Completed weighments"
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedWeighment}"
                      Style="{StaticResource DataGrid.Default}"
                      IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding SlipNumber}"
                                    Header="Slip"
                                    Width="110" />
                <DataGridTextColumn Binding="{Binding VehicleNumber}"
                                    Header="Vehicle"
                                    Width="140" />
                <DataGridTextColumn Binding="{Binding PartyName}"
                                    Header="Party"
                                    Width="*" />
                <DataGridTextColumn Binding="{Binding OpenedAtText}"
                                    Header="Opened"
                                    Width="140" />
              </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyState Icon="{StaticResource Icon.Search}"
                                 Message="No completed weighments found matching the search criteria."
                                 Title="No results">
                <controls:EmptyState.Style>
                    <Style BasedOn="{StaticResource {x:Type controls:EmptyState}}" TargetType="controls:EmptyState">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>
          </Grid>
        </controls:ModernCard>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
