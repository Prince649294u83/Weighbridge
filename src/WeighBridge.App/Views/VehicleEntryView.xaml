<!--
  VehicleEntryView

  The weighbridge operator's screen.
  Industrial F1/F2 workflow:
    - F1: First Entry (Vehicle details, Allocate Ticket, Record First Weight)
    - F2: Second Entry (Search / Queue selection, Historical Snapshot Locked, Second Entry fields, Complete Weighment)
    - F3: Read Indicator (Transfer live scale weight to input)
    - F5: Context-aware Submit (Allocate / Record Weight / Complete)
    - Esc: Clear active form context
-->
<UserControl x:Class="WeighBridge.App.Views.VehicleEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:VehicleEntryViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1100"
             mc:Ignorable="d">

  <UserControl.InputBindings>
    <KeyBinding Key="F1" Command="{Binding SwitchToFirstEntryCommand}" />
    <KeyBinding Key="F2" Command="{Binding SwitchToSecondEntryCommand}" />
    <KeyBinding Key="F3" Command="{Binding ReadIndicatorCommand}" />
    <KeyBinding Key="F5" Command="{Binding SubmitWorkflowCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ClearContextCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />

    <Style x:Key="Field.Label"
           BasedOn="{StaticResource Text.Label}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>

    <Style x:Key="Field.LockedLabel"
           BasedOn="{StaticResource Text.Caption}"
           TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="Margin" Value="0,4,0,1" />
    </Style>

    <Style x:Key="Field.LockedValue"
           BasedOn="{StaticResource Text.Body}"
           TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="StatusLine.Accent" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Default}" />
      <Setter Property="CornerRadius" Value="2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Information">
          <Setter Property="Background" Value="{DynamicResource Brush.Info.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
          <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource Brush.Warning.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Danger">
          <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Waiting.Empty"
           BasedOn="{StaticResource {x:Type controls:EmptyState}}"
           TargetType="controls:EmptyState">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AwaitingSecondWeight.Count}" Value="0">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Header  -->
    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.VehicleEntry}"
                            ShowSeparator="True"
                            Title="{Binding Title}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <controls:StatusBadge Margin="0,0,8,0"
                                Severity="{Binding WorkflowStateBadgeSeverity}"
                                Text="{Binding WorkflowStateBadgeText}" />
          <controls:StatusBadge Text="{Binding IndicatorText}" ConnectionState="{Binding IndicatorState}" />
          <Button Margin="10,0,0,0"
                  AutomationProperties.Name="Reload the waiting list"
                  Command="{Binding RefreshCommand}"
                  Content="{StaticResource Icon.Refresh}"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="Reload masters &amp; waiting list" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <!--  Workflow Action Bar (Hotkeys & Quick Switch)  -->
    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="12,8"
            Background="{DynamicResource Brush.Surface.Sunken}"
            CornerRadius="{StaticResource Radius.MD}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button AutomationProperties.Name="First Entry"
                  Command="{Binding SwitchToFirstEntryCommand}"
                  Margin="0,0,8,0"
                  Style="{StaticResource Button.Secondary}"
                  ToolTip="Start a new First Entry transaction (F1)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Default}" Text="[F1]" Margin="0,0,6,0" />
              <TextBlock Text="First Entry" />
            </StackPanel>
          </Button>

          <Button AutomationProperties.Name="Second Entry"
                  Command="{Binding SwitchToSecondEntryCommand}"
                  Margin="0,0,8,0"
                  Style="{StaticResource Button.Secondary}"
                  ToolTip="Search &amp; complete Second Entry transaction (F2)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Default}" Text="[F2]" Margin="0,0,6,0" />
              <TextBlock Text="Second Entry" />
            </StackPanel>
          </Button>

          <Button AutomationProperties.Name="Clear Context"
                  Command="{Binding ClearContextCommand}"
                  Margin="0,0,8,0"
                  Style="{StaticResource Button.Text}"
                  ToolTip="Clear current form inputs (Esc)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="Bold" Text="[Esc]" Margin="0,0,6,0" />
              <TextBlock Text="Clear Context" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Caption}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Text.Muted}"
                     Text="Hotkeys: [F1] First Entry  ·  [F2] Second Entry  ·  [F3] Read Indicator  ·  [F5] Submit  ·  [Esc] Clear" />
        </StackPanel>
      </Grid>
    </Border>

    <!--  Main 2-Column Content Grid  -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  ============================================================
            LEFT COLUMN: WORKSPACE (F1 / F2 / IDLE)
            ============================================================  -->
      <Grid Grid.Column="0">
        <!--  F1 (First Entry) Workspace  -->
        <ScrollViewer Style="{StaticResource ScrollViewer.Default}"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsF1Mode, Converter={StaticResource Converter.BooleanToVisibility}}">
          <controls:ModernCard Header="First Entry (F1)"
                               Icon="{StaticResource Icon.Scale}"
                               SubHeader="Open a new weighment for arriving vehicle">
            <StackPanel>
              <!--  Vehicle Number & Standard Tare  -->
              <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="Vehicle number *" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Accent.Default}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,2"
                           Visibility="{Binding HasStandardTareWeight, Converter={StaticResource Converter.BooleanToVisibility}}"
                           Text="{Binding StandardTareWeightKg, StringFormat='Std Tare: {0:N0} kg'}" />
              </Grid>
              <ComboBox AutomationProperties.Name="Vehicle number"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveVehicles}"
                        SelectedItem="{Binding SelectedVehicleOption, Mode=TwoWay}"
                        Text="{Binding VehicleNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />

              <!--  Vehicle Type & Arrival Mode  -->
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Vehicle type" />
                  <ComboBox AutomationProperties.Name="Vehicle type"
                            ItemsSource="{Binding ActiveVehicleTypes}"
                            SelectedItem="{Binding SelectedVehicleTypeOption, Mode=TwoWay}"
                            Style="{StaticResource ComboBox.Default}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Arrival mode *" />
                  <ComboBox AutomationProperties.Name="Arrival mode"
                            ItemsSource="{Binding ArrivalModeOptions}"
                            SelectedItem="{Binding SelectedArrivalMode}"
                            Style="{StaticResource ComboBox.Default}" />
                </StackPanel>
              </Grid>

              <!--  Party & Material  -->
              <TextBlock Style="{StaticResource Field.Label}" Text="Party / Customer" />
              <ComboBox AutomationProperties.Name="Party"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveParties}"
                        SelectedItem="{Binding SelectedPartyOption, Mode=TwoWay}"
                        Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />

              <TextBlock Style="{StaticResource Field.Label}" Text="Material / Commodity" />
              <ComboBox AutomationProperties.Name="Material"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveMaterials}"
                        SelectedItem="{Binding SelectedMaterialOption, Mode=TwoWay}"
                        Text="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />

              <!--  Driver & Transporter  -->
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Driver name" />
                  <TextBox AutomationProperties.Name="Driver"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Transporter" />
                  <TextBox AutomationProperties.Name="Transporter"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding TransporterName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <!--  Charges & Remarks  -->
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Charges (₹)" />
                  <TextBox AutomationProperties.Name="Charges"
                           Style="{StaticResource TextBox.Numeric}"
                           Text="{Binding Charges, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Remarks" />
                  <TextBox AutomationProperties.Name="Remarks"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <!--  Custom Fields 1 & 2  -->
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Custom Field 1" />
                  <TextBox AutomationProperties.Name="CustomField1"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding CustomField1, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Field.Label}" Text="Custom Field 2" />
                  <TextBox AutomationProperties.Name="CustomField2"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding CustomField2, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <Separator Margin="0,16,0,16" Style="{StaticResource Separator.Horizontal}" />

              <!--  F1 Step 1: Allocate Ticket Button  -->
              <Button AutomationProperties.Name="1. Allocate Ticket"
                      Command="{Binding AllocateTicketCommand}"
                      HorizontalAlignment="Stretch"
                      Content="1. Allocate Ticket"
                      Style="{StaticResource Button.Secondary}" />

              <!--  F1 Step 2: Weight Input & First Weight Commit (F5)  -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource Text.Label}" Text="First weight (kg)" />
                  <TextBox AutomationProperties.Name="First weight in kilograms"
                           Style="{StaticResource TextBox.Numeric}"
                           Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1"
                        AutomationProperties.Name="Read (F3)"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding ReadIndicatorCommand}"
                        Content="Read (F3)"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Capture settled weight from indicator" />

                <Button Grid.Column="2"
                        AutomationProperties.Name="2. Record Wt (F5)"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding RecordFirstWeightCommand}"
                        Content="2. Record Wt (F5)"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Record first weight and queue for second weight" />
              </Grid>
            </StackPanel>
          </controls:ModernCard>
        </ScrollViewer>

        <!--  F2 (Second Entry) Workspace  -->
        <ScrollViewer Style="{StaticResource ScrollViewer.Default}"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsF2Mode, Converter={StaticResource Converter.BooleanToVisibility}}">
          <controls:ModernCard Header="Second Entry (F2)"
                               Icon="{StaticResource Icon.Clock}"
                               SubHeader="Search pending ticket or select from queue below">
            <StackPanel>
              <!--  Scanner-style Search Header  -->
              <TextBlock Style="{StaticResource Text.Label}" Text="Search Ticket / Vehicle (Enter to resolve)" />
              <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         AutomationProperties.Name="Search pending ticket"
                         Style="{StaticResource TextBox.Default}"
                         Text="{Binding F2SearchKey, UpdateSourceTrigger=PropertyChanged}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchPendingSecondEntryCommand}" />
                  </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        AutomationProperties.Name="Search"
                        Margin="8,0,0,0"
                        Command="{Binding SearchPendingSecondEntryCommand}"
                        Content="Search"
                        Style="{StaticResource Button.Secondary}" />
              </Grid>

              <!--  🔒 Locked Historical Snapshot Section  -->
              <Border Background="{DynamicResource Brush.Surface.Sunken}"
                      CornerRadius="{StaticResource Radius.MD}"
                      Padding="12"
                      Margin="0,0,0,14"
                      Visibility="{Binding HasCurrent, Converter={StaticResource Converter.BooleanToVisibility}}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock Text="Historical F1 Snapshot (Locked)" FontWeight="Bold" Style="{StaticResource Text.Subtitle}" />
                    </StackPanel>

                    <controls:StatusBadge Grid.Column="1" Severity="Warning" Text="Immutable" />
                  </Grid>

                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource Field.LockedLabel}" Text="Slip Number" />
                      <TextBlock Style="{StaticResource Field.LockedValue}" Text="{Binding Current.SlipNumber}" />

                      <TextBlock Style="{StaticResource Field.LockedLabel}" Text="Party" />
                      <TextBlock Style="{StaticResource Field.LockedValue}" Text="{Binding Current.PartyName, TargetNullValue='—'}" />

                      <TextBlock Style="{StaticResource Field.LockedLabel}" Text="First Weight" />
                      <TextBlock Style="{StaticResource Field.LockedValue}" Foreground="{DynamicResource Brush.Accent.Default}" Text="{Binding Current.FirstWeightText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                      <TextBlock Style="{StaticResource Field.LockedLabel}" Text="Vehicle" />
                      <TextBlock Style="{StaticResource Field.LockedValue}" Text="{Binding Current.VehicleNumber}" />

                      <TextBlock Style="{StaticResource Field.LockedLabel}" Text="Material" />
                      <TextBlock Style="{StaticResource Field.LockedValue}" Text="{Binding Current.MaterialName, TargetNullValue='—'}" />

                      <TextBlock Style="{StaticResource Field.LockedLabel}" Text="First Charges" />
                      <TextBlock Style="{StaticResource Field.LockedValue}" Text="{Binding Current.ChargesText}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!--  ✏️ Editable Second Entry Section  -->
              <Border Background="{DynamicResource Brush.Surface.Card}"
                      BorderBrush="{DynamicResource Brush.Border.Default}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius.MD}"
                      Padding="12"
                      Visibility="{Binding HasCurrent, Converter={StaticResource Converter.BooleanToVisibility}}">
                <StackPanel>
                  <TextBlock Text="✏️ Second Entry Details (Editable)" FontWeight="Bold" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />

                  <!--  Charges & Gate Pass  -->
                  <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource Field.Label}" Text="Second Charges (₹)" />
                      <TextBox AutomationProperties.Name="Second charges"
                               Style="{StaticResource TextBox.Numeric}"
                               Text="{Binding SecondCharges, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Field.Label}" Text="Gate Pass Number" />
                      <TextBox AutomationProperties.Name="Gate pass number"
                               Style="{StaticResource TextBox.Default}"
                               Text="{Binding GatePassNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>

                  <!--  Bags & Bag Weight  -->
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource Field.Label}" Text="Number of Bags" />
                      <TextBox AutomationProperties.Name="Number of bags"
                               Style="{StaticResource TextBox.Numeric}"
                               Text="{Binding NumberOfBags, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Field.Label}" Text="Bag Wt (kg)" />
                      <TextBox AutomationProperties.Name="Bag weight in kg"
                               Style="{StaticResource TextBox.Numeric}"
                               Text="{Binding BagWeightKg, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>

                  <!--  Computed Bag Deduction Info  -->
                  <Grid Margin="0,4,0,0" Visibility="{Binding HasBagDeduction, Converter={StaticResource Converter.BooleanToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Info.Default}"
                               Text="{Binding TotalBagWeightKg, StringFormat='Total Bag Deduction: {0:N2} kg'}" />
                  </Grid>

                  <!--  Remarks & Custom Fields 3 & 4  -->
                  <TextBlock Style="{StaticResource Field.Label}" Text="Remarks" />
                  <TextBox AutomationProperties.Name="F2 Remarks"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding F2Remarks, UpdateSourceTrigger=PropertyChanged}" />

                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource Field.Label}" Text="Custom Field 3" />
                      <TextBox AutomationProperties.Name="CustomField3"
                               Style="{StaticResource TextBox.Default}"
                               Text="{Binding CustomField3, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Field.Label}" Text="Custom Field 4" />
                      <TextBox AutomationProperties.Name="CustomField4"
                               Style="{StaticResource TextBox.Default}"
                               Text="{Binding CustomField4, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>

                  <!--  Concurrency Conflict Banner  -->
                  <Border Background="{DynamicResource Brush.Danger.Subtle}"
                          BorderBrush="{DynamicResource Brush.Danger.Default}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource Radius.SM}"
                          Padding="8"
                          Margin="0,12,0,0"
                          Visibility="{Binding HasConcurrencyConflict, Converter={StaticResource Converter.BooleanToVisibility}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource Text.Caption}"
                                 Foreground="{DynamicResource Brush.Danger.Default}"
                                 Text="Weighment modified by another process. Unsaved edits preserved." />
                      <Button Grid.Column="1"
                              Margin="8,0,0,0"
                              Command="{Binding ReloadActiveTransactionCommand}"
                              Content="Reload"
                              Style="{StaticResource Button.Secondary}" />
                    </Grid>
                  </Border>

                  <Separator Margin="0,14,0,14" Style="{StaticResource Separator.Horizontal}" />

                  <!--  Second Weight Input & Complete (F5)  -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource Text.Label}" Text="Second weight (kg)" />
                      <TextBox AutomationProperties.Name="Second weight in kilograms"
                               Style="{StaticResource TextBox.Numeric}"
                               Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Command="{Binding ReadIndicatorCommand}"
                            Content="Read (F3)"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Capture settled weight from indicator" />

                    <Button Grid.Column="2"
                            AutomationProperties.Name="Complete (F5)"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Command="{Binding RecordSecondWeightCommand}"
                            Content="Complete (F5)"
                            Style="{StaticResource Button.Primary}"
                            ToolTip="Record second weight and finalize weighment" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </controls:ModernCard>
        </ScrollViewer>

        <!--  Idle / Resting Workspace  -->
        <controls:ModernCard Header="Operator Workflow"
                             Icon="{StaticResource Icon.Scale}"
                             SubHeader="Select an action to begin weighing"
                             Visibility="{Binding IsIdle, Converter={StaticResource Converter.BooleanToVisibility}}">
          <StackPanel VerticalAlignment="Center" Margin="0,30,0,30">
            <controls:EmptyState Icon="{StaticResource Icon.Scale}"
                                 Message="Press [F1] to start a new vehicle First Entry, or [F2] / double-click a waiting vehicle below to complete a Second Entry."
                                 Title="Ready for Transaction" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
              <Button Command="{Binding SwitchToFirstEntryCommand}"
                      Margin="0,0,12,0"
                      Style="{StaticResource Button.Primary}"
                      Content="Start First Entry (F1)" />
              <Button Command="{Binding SwitchToSecondEntryCommand}"
                      Style="{StaticResource Button.Secondary}"
                      Content="Search Second Entry (F2)" />
            </StackPanel>
          </StackPanel>
        </controls:ModernCard>
      </Grid>

      <!--  ============================================================
            RIGHT COLUMN: HUD, STATUS, SUMMARY, PENDING QUEUE
            ============================================================  -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Live Scale Weight HUD Card  -->
        <controls:ModernCard Grid.Row="0"
                             Margin="0,0,0,12"
                             Header="Live Scale Readout">
          <controls:ModernCard.HeaderActions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource Text.Caption}"
                         Text="{Binding CameraStatusText}" />
              <controls:StatusBadge Margin="0,0,6,0"
                                    Severity="{Binding StabilitySeverity}"
                                    Text="{Binding StabilityStatusText}" />
              <Border Padding="6,2"
                      Background="{DynamicResource Brush.Surface.Sunken}"
                      CornerRadius="{StaticResource Radius.SM}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LiveSourceText}" />
              </Border>
            </StackPanel>
          </controls:ModernCard.HeaderActions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Text.Label}" Text="Live weight on platform" />
              <Viewbox HorizontalAlignment="Left" MaxHeight="42" StretchDirection="DownOnly">
                <TextBlock AutomationProperties.Name="Live scale weight"
                           Style="{StaticResource Text.Numeric.Large}"
                           Text="{Binding LiveWeightDisplay}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
              </Viewbox>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <Button Margin="8,0,0,0"
                      Command="{Binding ReadIndicatorCommand}"
                      Content="Read indicator (F3)"
                      Style="{StaticResource Button.Secondary}"
                      ToolTip="Capture settled weight from indicator" />
            </StackPanel>
          </Grid>
        </controls:ModernCard>

        <!--  Status Line  -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{StaticResource Radius.MD}"
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding HasStatus, Converter={StaticResource Converter.BooleanToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusLine.Accent}" />

            <TextBlock Grid.Column="1"
                       Margin="14,10,14,10"
                       Style="{StaticResource Text.Body.Wrapped}"
                       Text="{Binding StatusMessage}" />
          </Grid>
        </Border>

        <!--  Active Weighment Summary Card  -->
        <controls:ModernCard Grid.Row="2"
                             Margin="0,0,0,12"
                             Header="Current Weighment Summary"
                             Visibility="{Binding HasCurrent, Converter={StaticResource Converter.BooleanToVisibility}}">
          <controls:ModernCard.HeaderActions>
            <controls:StatusBadge Severity="{Binding Current.StatusSeverity}" Text="{Binding Current.StatusText}" />
          </controls:ModernCard.HeaderActions>

          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource Text.Label}" Text="Slip" />
                <TextBlock Style="{StaticResource Text.Numeric.Emphasis}" Text="{Binding Current.SlipNumber}" />
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Current.VehicleNumber}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Current.ModeText}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Current.Details}" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,10,0,10" Style="{StaticResource Separator.Horizontal}" />

            <!--  Weights Grid: Gross, Tare, Net, Bag Deduction, Actual Material Weight  -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Text.Label}" Text="Gross (kg)" />
                <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding Current.GrossText}" />
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Text.Label}" Text="Tare (kg)" />
                <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding Current.TareText}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Text.Label}" Text="Net (kg)" />
                <TextBlock Style="{StaticResource Text.Numeric.Emphasis}" Text="{Binding Current.NetText}" />
              </StackPanel>
            </Grid>

            <!--  Bag Deduction & Actual Material Breakdown  -->
            <Grid Margin="0,8,0,0" Visibility="{Binding Current.HasBagDeduction, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Text.Label}" Text="Bags" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Current.NumberOfBags, TargetNullValue='—'}" />
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Text.Label}" Text="Bag Deduction (kg)" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Current.BagDeductionText}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Text.Label}" Text="Actual Material (kg)" />
                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Success.Default}" Text="{Binding Current.ActualWeightText}" />
              </StackPanel>
            </Grid>

            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Current.ProvenanceText}"
                       Visibility="{Binding Current.ShowProvenance, Converter={StaticResource Converter.BooleanToVisibility}}" />

            <!--  Cancellation Section  -->
            <Grid Margin="0,10,0,0" Visibility="{Binding CanCancel, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBox Grid.Column="0"
                       AutomationProperties.Name="Reason for cancelling"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" />

              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Command="{Binding CancelWeighmentCommand}"
                      Content="Cancel Slip"
                      Style="{StaticResource Button.Danger}" />
            </Grid>
          </StackPanel>
        </controls:ModernCard>

        <!--  Pending Queue Card  -->
        <controls:ModernCard Grid.Row="3"
                             Header="Waiting for second weight"
                             Icon="{StaticResource Icon.Clock}"
                             SubHeader="Double-click or press Enter on a row to load into Second Entry">
          <Grid>
            <DataGrid AutomationProperties.Name="Vehicles waiting for their second weight"
                      ItemsSource="{Binding AwaitingSecondWeight}"
                      SelectedItem="{Binding SelectedAwaiting}"
                      MouseDoubleClick="OnWaitingRowDoubleClick"
                      Style="{StaticResource DataGrid.Default}">
              <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SelectPendingTransactionCommand}" />
              </DataGrid.InputBindings>
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding SlipNumber}" Header="Slip" Width="100" />
                <DataGridTextColumn Binding="{Binding VehicleNumber}" Header="Vehicle" Width="130" />
                <DataGridTextColumn Binding="{Binding PartyName}" Header="Party" Width="140" />
                <DataGridTextColumn Binding="{Binding MaterialName}" Header="Material" Width="120" />
                <DataGridTextColumn Binding="{Binding FirstWeightText}" Header="1st Wt (kg)" Width="100" />
                <DataGridTextColumn Binding="{Binding WaitingDurationText}" Header="Waiting" Width="80" />
                <DataGridTextColumn Binding="{Binding OpenedAtText}" Header="Time In" Width="*" />
              </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyState Icon="{StaticResource Icon.CheckMark}"
                                 Message="No vehicles waiting for second weight."
                                 Style="{StaticResource Waiting.Empty}"
                                 Title="Queue Empty" />
          </Grid>
        </controls:ModernCard>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
