<!--
  VehicleEntryView

  The weighbridge operator's screen.
  Industrial F1/F2 workflow:
    - 1 Workflow Mode Control: Entry (F1/F2)
    - 1 Generated / Read-Only Ticket: Ticket No (WB-XXXXXX)
    - 6 Editable Business Inputs: Vehicle No, Vehicle Type, Party Name, Material, Charges, Gross(G)/Tare(T)
    - 3 Read-Only Weight Outputs: Gross Weight, Tare Weight, Net Weight
    - 1 Live Scale HUD (0 Kg) + Settings Navigation
    - 1 Pending Transactions Queue
-->
<UserControl x:Class="WeighBridge.App.Views.VehicleEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:VehicleEntryViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1100"
             mc:Ignorable="d">

  <UserControl.InputBindings>
    <KeyBinding Key="F1" Command="{Binding SwitchToFirstEntryCommand}" />
    <KeyBinding Key="F2" Command="{Binding SwitchToSecondEntryCommand}" />
    <KeyBinding Key="F3" Command="{Binding ReadIndicatorCommand}" />
    <KeyBinding Key="F5" Command="{Binding SubmitWorkflowCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ClearContextCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanConverter x:Key="Converter.InverseBoolean" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />

    <Style x:Key="Field.Label"
           BasedOn="{StaticResource Text.Label}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Field.LockedLabel"
           BasedOn="{StaticResource Text.Caption}"
           TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="Margin" Value="0,4,0,1" />
    </Style>

    <Style x:Key="Field.LockedValue"
           BasedOn="{StaticResource Text.Body}"
           TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Top Bar: Title, Date/Time, Status & Actions  -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.H2}" Text="Vehicle Entry" VerticalAlignment="Center" Margin="0,0,16,0" />
        <controls:StatusBadge Margin="0,0,8,0"
                              Severity="{Binding WorkflowStateBadgeSeverity}"
                              Text="{Binding WorkflowStateBadgeText}" />
        <controls:StatusBadge Text="{Binding IndicatorText}" ConnectionState="{Binding IndicatorState}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.Body}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   Text="{Binding CurrentTimeDisplay}" />
        <Button AutomationProperties.Name="Reload"
                Command="{Binding RefreshCommand}"
                Content="{StaticResource Icon.Refresh}"
                Style="{StaticResource Button.Icon}"
                ToolTip="Reload masters &amp; waiting list" />
      </StackPanel>
    </Grid>

    <!--  Main 2-Column Operational Grid  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  ============================================================
            LEFT COLUMN: 1 MODE + 1 TICKET + 6 INPUTS + 3 WEIGHT OUTPUTS
            ============================================================  -->
      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Surface.Raised}"
              BorderBrush="{DynamicResource Brush.Border.Default}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.MD}"
              Padding="14,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel PreviewKeyDown="OnFormPreviewKeyDown">
            <!--  Entry (F1/F2)  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Entry(F1/F2)" />
              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        AutomationProperties.Name="Switch To F1"
                        Command="{Binding SwitchToFirstEntryCommand}"
                        Padding="0,5"
                        HorizontalContentAlignment="Center">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                      <Setter Property="MinWidth" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsF1Mode}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock FontWeight="Bold" Text="New (F1)" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button Grid.Column="2"
                        AutomationProperties.Name="Switch To F2"
                        Command="{Binding SwitchToSecondEntryCommand}"
                        Padding="0,5"
                        HorizontalContentAlignment="Center">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                      <Setter Property="MinWidth" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsF2Mode}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock FontWeight="Bold" Text="Pending (F2)" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
              </Grid>
            </Grid>

            <!--  Ticket No / F2 Search  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Ticket No" />
              <!-- When F1 or when Ticket already loaded in F2 -->
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Ticket No"
                       FontWeight="Bold"
                       IsReadOnly="True"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding ActiveSlipNumber, Mode=OneWay, TargetNullValue='Not allocated'}"
                       Visibility="{Binding IsF2SearchActive, Converter={StaticResource Converter.InverseBooleanToVisibility}}" />
              <!-- When in F2 Search mode: direct search input + Find button -->
              <Grid Grid.Column="1" Visibility="{Binding IsF2SearchActive, Converter={StaticResource Converter.BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         AutomationProperties.Name="F2 Search Input"
                         Style="{StaticResource TextBox.Default}"
                         Text="{Binding F2SearchKey, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2"
                         AutomationProperties.Name="Search Pending"
                         Command="{Binding SearchPendingSecondEntryCommand}"
                         Style="{StaticResource Button.Secondary}"
                         Padding="10,4"
                         ToolTip="Search pending ticket [Enter]">
                  <TextBlock Text="Find" FontWeight="Bold" />
                </Button>
              </Grid>
            </Grid>

            <!--  Vehicle No  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Vehicle No" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Vehicle No"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveVehicles}"
                        SelectedItem="{Binding SelectedVehicleOption, Mode=TwoWay}"
                        Text="{Binding VehicleNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Vehicle Type  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Vehicle Type" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Vehicle Type"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveVehicleTypes}"
                        SelectedItem="{Binding SelectedVehicleTypeOption, Mode=TwoWay}"
                        Text="{Binding SelectedVehicleTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Party Name  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Party Name" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Party Name"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveParties}"
                        SelectedItem="{Binding SelectedPartyOption, Mode=TwoWay}"
                        Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Material  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Material" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Material"
                        IsEditable="True"
                        ItemsSource="{Binding ActiveMaterials}"
                        SelectedItem="{Binding SelectedMaterialOption, Mode=TwoWay}"
                        Text="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Charges  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Charges" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Charges"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding Charges, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  GST on Charges Breakdown  -->
            <Grid Margin="0,0,0,5" Visibility="{Binding IsGstOnChargesEnabled, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="GST / Total" />
              <TextBox Grid.Column="1"
                       IsReadOnly="True"
                       ToolTip="GST Amount (18%)"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding GstAmount, StringFormat='{}{0:N2}', Mode=OneWay}" />
              <TextBox Grid.Column="3"
                       IsReadOnly="True"
                       ToolTip="Total Charges with GST"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       FontWeight="Bold"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding TotalChargesWithGst, StringFormat='{}{0:N2}', Mode=OneWay}" />
            </Grid>

            <!--  Second Entry Charges  -->
            <Grid Margin="0,0,0,5" Visibility="{Binding IsSecondChargesVisible, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="2nd Charges" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Second Charges"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding SecondCharges, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Price Computing (Rate & Total)  -->
            <Grid Margin="0,0,0,5" Visibility="{Binding IsPriceComputingEnabled, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Rate / Amount" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Material Rate"
                       ToolTip="Rate per kg/ton (₹)"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding MaterialRate, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="3"
                       AutomationProperties.Name="Total Amount"
                       ToolTip="Total material amount (Rate × Net)"
                       IsReadOnly="True"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding TotalMaterialAmount, StringFormat='{}{0:N2}', Mode=OneWay}" />
            </Grid>

            <!--  Unit Bags Weight Column  -->
            <Grid Margin="0,0,0,5" Visibility="{Binding IsUnitBagsWeightColumnEnabled, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Bags / Bag Wt" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Number of Bags"
                       ToolTip="Number of bags"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding NumberOfBags, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="3"
                       AutomationProperties.Name="Bag Weight Kg"
                       ToolTip="Tare weight per empty bag (kg)"
                       Style="{StaticResource TextBox.Numeric}"
                       Text="{Binding BagWeightKg, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Gross(G) / Tare(T) / Auto(A) / Manual(M)  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ModeLabelText}" />
              
              <!-- In F1: quick mode buttons (G / T / A / M) -->
              <UniformGrid Grid.Column="1" Rows="1" Visibility="{Binding IsF1Mode, Converter={StaticResource Converter.BooleanToVisibility}}">
                <Button AutomationProperties.Name="Select Gross Mode"
                        Command="{Binding SelectGrossModeCommand}"
                        Padding="0,3"
                        Margin="0,0,2,0"
                        ToolTip="Arrived loaded — gross weight first (G)"
                        HorizontalContentAlignment="Center">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                      <Setter Property="Height" Value="28" />
                      <Setter Property="MinWidth" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGrossFirstSelected}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock FontWeight="SemiBold" FontSize="11" Text="G" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button AutomationProperties.Name="Select Tare Mode"
                        Command="{Binding SelectTareModeCommand}"
                        Padding="0,3"
                        Margin="2,0,2,0"
                        ToolTip="Arrived empty — tare weight first (T)"
                        HorizontalContentAlignment="Center">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                      <Setter Property="Height" Value="28" />
                      <Setter Property="MinWidth" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTareFirstSelected}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock FontWeight="SemiBold" FontSize="11" Text="T" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button AutomationProperties.Name="Select Auto Tare Mode"
                        Command="{Binding SelectAutoTareModeCommand}"
                        Padding="0,3"
                        Margin="2,0,2,0"
                        ToolTip="Auto tare weight from vehicle master (A)"
                        Visibility="{Binding IsAutoTareWeightEnabled, Converter={StaticResource Converter.BooleanToVisibility}}"
                        HorizontalContentAlignment="Center">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                      <Setter Property="Height" Value="28" />
                      <Setter Property="MinWidth" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAutoTareModeSelected}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Default}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock FontWeight="SemiBold" FontSize="11" Text="A" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button AutomationProperties.Name="Select Manual Tare Mode"
                        Command="{Binding SelectManualTareModeCommand}"
                        Padding="0,3"
                        Margin="2,0,0,0"
                        ToolTip="Manual tare weight input (M)"
                        Visibility="{Binding CanEnterManualWeight, Converter={StaticResource Converter.BooleanToVisibility}}"
                        HorizontalContentAlignment="Center">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                      <Setter Property="Height" Value="28" />
                      <Setter Property="MinWidth" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsManualTareModeSelected}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Warning.Default}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Default}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock FontWeight="SemiBold" FontSize="11" Text="M" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
              </UniformGrid>

              <!-- In F2: Locked complementary role derived from stored transaction state -->
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="F2 Derived Mode"
                       FontWeight="Bold"
                       IsReadOnly="True"
                       HorizontalContentAlignment="Center"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding F2DerivedModeText, Mode=OneWay}"
                       Visibility="{Binding IsF2Mode, Converter={StaticResource Converter.BooleanToVisibility}}" />
            </Grid>

            <!--  Divider  -->
            <Separator Margin="0,3,0,6" Background="{DynamicResource Brush.Border.Subtle}" />

            <!--  Gross Weight (Output / Input)  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Gross Weight" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Gross Weight Output"
                       FontWeight="Bold"
                       IsReadOnly="{Binding IsGrossWeightReadOnly}"
                       HorizontalContentAlignment="Right"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding GrossWeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Tare Weight (Output / Input)  -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Tare Weight" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Tare Weight Output"
                       FontWeight="Bold"
                       IsReadOnly="{Binding IsTareWeightReadOnly}"
                       HorizontalContentAlignment="Right"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding TareWeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Net Weight (Output)  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Default}" Text="Net Weight" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Net Weight Output"
                       FontWeight="Bold"
                       IsReadOnly="True"
                       HorizontalContentAlignment="Right"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Foreground="{DynamicResource Brush.Accent.Default}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding DisplayNetWeightKg, StringFormat='{}{0:N0}', Mode=OneWay}" />
            </Grid>

            <!--  Actual Weight (Net - Total Bags)  -->
            <Grid Margin="0,0,0,6" Visibility="{Binding IsUnitBagsWeightColumnEnabled, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Actual Weight" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Actual Weight Output"
                       FontWeight="Bold"
                       IsReadOnly="True"
                       HorizontalContentAlignment="Right"
                       Background="{DynamicResource Brush.Surface.Sunken}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding EstimatedActualWeightKg, StringFormat='{}{0:N0}', Mode=OneWay}" />
            </Grid>

            <!--  Weight Input (When manual or reading indicator)  -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Capture Weight" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Weight Input"
                       FontWeight="Bold"
                       HorizontalContentAlignment="Right"
                       IsReadOnly="{Binding CanEnterManualWeight, Converter={StaticResource Converter.InverseBoolean}}"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="Read Scale"
                      Command="{Binding ReadIndicatorCommand}"
                      Style="{StaticResource Button.Secondary}"
                      Padding="8,4"
                      ToolTip="Read live weight from indicator [F3]">
                <TextBlock FontWeight="Bold" Text="[F3]" />
              </Button>
            </Grid>

            <!--  Submit Action Row (F5 Submit / Clear)  -->
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0"
                      AutomationProperties.Name="Submit Workflow"
                      Command="{Binding SubmitWorkflowCommand}"
                      Style="{StaticResource Button.Primary}"
                      ToolTip="Save / Complete Weighment [F5]">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontWeight="Bold" Margin="0,0,6,0" Text="[F5]" />
                  <TextBlock Text="Submit / Save" />
                </StackPanel>
              </Button>

              <Button Grid.Column="2"
                      AutomationProperties.Name="Clear Form"
                      Command="{Binding ClearContextCommand}"
                      Style="{StaticResource Button.Secondary}"
                      ToolTip="Clear active inputs [Esc]">
                <TextBlock Text="Clear" />
              </Button>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!--  ============================================================
            RIGHT COLUMN: SCALE HUD (0 Kg) + SETTINGS & PENDING QUEUE
            ============================================================  -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  TOP: DIGITAL SCALE HUD & SETTINGS BUTTON  -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>

          <!--  Digital Scale HUD Box (Black Background + Bright Green Digits)  -->
          <Border Grid.Column="0"
                  Background="#000000"
                  BorderBrush="#333333"
                  BorderThickness="2"
                  CornerRadius="{StaticResource Radius.MD}"
                  Padding="24,12"
                  MinHeight="90">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="40"
                         FontWeight="Bold"
                         Foreground="#00FF00"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{Binding LiveWeightDisplay}" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource Text.Caption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Success.Default}"
                           Text="{Binding StabilityStatusText}" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Foreground="#888888"
                           Text="{Binding LiveSourceText}" />
              </StackPanel>
            </Grid>
          </Border>

          <!--  Settings Navigation Button  -->
          <Button Grid.Column="2"
                  AutomationProperties.Name="Settings"
                  Command="{Binding OpenSettingsCommand}"
                  Style="{StaticResource Button.Secondary}"
                  VerticalAlignment="Stretch"
                  ToolTip="Open WeighBridge System Settings">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}"
                         Text="{StaticResource Icon.Settings}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,4"
                         FontSize="20" />
              <TextBlock FontWeight="SemiBold" Text="Settings" />
            </StackPanel>
          </Button>
        </Grid>

        <!--  BOTTOM: PENDING TRANSACTIONS TABLE  -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="16,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Section Header  -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Style="{StaticResource Text.H3}"
                         Text="Pending Transactions"
                         VerticalAlignment="Center" />

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Text="Double-click row to load into Second Entry [F2]" />
                <Button AutomationProperties.Name="Load Selected Pending"
                        Command="{Binding SelectPendingTransactionCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="8,3"
                        ToolTip="Load selected pending ticket into Second Entry">
                  <TextBlock Text="Load Selected [F2]" FontWeight="SemiBold" />
                </Button>
              </StackPanel>
            </Grid>

            <!--  DataGrid  -->
            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding AwaitingSecondWeight}"
                      SelectedItem="{Binding SelectedAwaiting, Mode=TwoWay}"
                      SelectionMode="Single"
                      MouseDoubleClick="OnWaitingRowDoubleClick"
                      Style="{StaticResource DataGrid.Default}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Ticket No."
                                    Binding="{Binding SlipNumber}"
                                    Width="100" />
                <DataGridTextColumn Header="Vehicle No"
                                    Binding="{Binding VehicleNumber}"
                                    Width="110" />
                <DataGridTextColumn Header="Vehicle Type"
                                    Binding="{Binding VehicleTypeName}"
                                    Width="100" />
                <DataGridTextColumn Header="Party Name"
                                    Binding="{Binding PartyName}"
                                    Width="*" />
                <DataGridTextColumn Header="Charges 1st"
                                    Binding="{Binding Charges, StringFormat='₹{0:N0}'}"
                                    Width="90" />
                <DataGridTextColumn Header="Material"
                                    Binding="{Binding MaterialName}"
                                    Width="110" />
                <DataGridTextColumn Header="Gross Weight"
                                    Binding="{Binding GrossKg, StringFormat='{}{0:N0} kg'}"
                                    Width="100" />
                <DataGridTextColumn Header="Tare Weight"
                                    Binding="{Binding TareKg, StringFormat='{}{0:N0} kg'}"
                                    Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
