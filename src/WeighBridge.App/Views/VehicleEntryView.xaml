<!--
  VehicleEntryView

  The weighbridge operator's screen. Two columns:
    - left: the form that opens a weighment for an arriving vehicle
    - right: the weighment being worked on, and the vehicles expected back for their
      second weight

  Everything the operator has to know is on screen without a click: which vehicle, which
  stage, the weights taken so far, what happens next, and what the last action did. The
  status line is the only report of success or failure, because the notification centre
  has no visual host yet.
-->
<UserControl x:Class="WeighBridge.App.Views.VehicleEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:VehicleEntryViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             mc:Ignorable="d">

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />

    <!--  Field label sitting above its input.  -->
    <Style x:Key="Field.Label"
           BasedOn="{StaticResource Text.Label}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!--
      Severity colour for the status line.

      A triggered Background with DynamicResource rather than a converter, for the reason
      the shell's status dots use one: a converter hands back the brush that was current
      when it ran, so the colour would stay behind after a theme switch.
    -->
    <Style x:Key="StatusLine.Accent" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Default}" />
      <Setter Property="CornerRadius" Value="2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Information">
          <Setter Property="Background" Value="{DynamicResource Brush.Info.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
          <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource Brush.Warning.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Danger">
          <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--
      Shown in place of the waiting list while nothing is waiting. BasedOn the control's own
      default style, because an explicit Style replaces the default outright rather than
      adding to it - without it the control loses its template and draws nothing at all.
    -->
    <Style x:Key="Waiting.Empty"
           BasedOn="{StaticResource {x:Type controls:EmptyState}}"
           TargetType="controls:EmptyState">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AwaitingSecondWeight.Count}" Value="0">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.VehicleEntry}"
                            ShowSeparator="True"
                            Title="{Binding Title}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <!--
            The badge takes its colour from the indicator's real state, and Text is set
            before ConnectionState so the control keeps this wording rather than
            substituting the enum name.
          -->
          <controls:StatusBadge Text="{Binding IndicatorText}" ConnectionState="{Binding IndicatorState}" />

          <Button Margin="10,0,0,0"
                  AutomationProperties.Name="Reload the waiting list"
                  Command="{Binding RefreshCommand}"
                  Content="{StaticResource Icon.Refresh}"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="Reload the waiting list" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  ============================================================
            New weighment
            ============================================================  -->
      <ScrollViewer Grid.Column="0"
                    Style="{StaticResource ScrollViewer.Default}"
                    VerticalScrollBarVisibility="Auto">
        <controls:ModernCard Header="New weighment"
                             Icon="{StaticResource Icon.Scale}"
                             SubHeader="Open a weighment for an arriving vehicle">
          <StackPanel>
            <Grid Margin="0,4,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Style="{StaticResource Text.Label}"
                         Text="Vehicle number" />
              <TextBlock Grid.Column="1"
                         Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource Brush.Accent.Default}"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,2"
                         Visibility="{Binding HasStandardTareWeight, Converter={StaticResource Converter.BooleanToVisibility}}"
                         Text="{Binding StandardTareWeightKg, StringFormat='Std Tare: {0:N0} kg'}" />
            </Grid>
            <ComboBox AutomationProperties.Name="Vehicle number"
                      IsEditable="True"
                      ItemsSource="{Binding ActiveVehicles}"
                      SelectedItem="{Binding SelectedVehicleOption, Mode=TwoWay}"
                      Text="{Binding VehicleNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource ComboBox.Default}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Vehicle type" />
            <ComboBox AutomationProperties.Name="Vehicle type"
                      ItemsSource="{Binding ActiveVehicleTypes}"
                      SelectedItem="{Binding SelectedVehicleTypeOption, Mode=TwoWay}"
                      Style="{StaticResource ComboBox.Default}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Arrived" />
            <ComboBox AutomationProperties.Name="Whether the vehicle arrived loaded or empty"
                      ItemsSource="{Binding ArrivalModeOptions}"
                      SelectedItem="{Binding SelectedArrivalMode}"
                      Style="{StaticResource ComboBox.Default}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Party" />
            <ComboBox AutomationProperties.Name="Party"
                      IsEditable="True"
                      ItemsSource="{Binding ActiveParties}"
                      SelectedItem="{Binding SelectedPartyOption, Mode=TwoWay}"
                      Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource ComboBox.Default}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Material" />
            <ComboBox AutomationProperties.Name="Material"
                      IsEditable="True"
                      ItemsSource="{Binding ActiveMaterials}"
                      SelectedItem="{Binding SelectedMaterialOption, Mode=TwoWay}"
                      Text="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource ComboBox.Default}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Driver" />
            <TextBox AutomationProperties.Name="Driver"
                     Style="{StaticResource TextBox.Default}"
                     Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Transporter" />
            <TextBox AutomationProperties.Name="Transporter"
                     Style="{StaticResource TextBox.Default}"
                     Text="{Binding TransporterName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Remarks" />
            <TextBox Height="64"
                     AutomationProperties.Name="Remarks"
                     Style="{StaticResource TextBox.Multiline}"
                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button Command="{Binding ClearFormCommand}"
                      Content="Clear"
                      Style="{StaticResource Button.Text}" />
              <Button Margin="10,0,0,0"
                      Command="{Binding OpenWeighmentCommand}"
                      Content="Open weighment"
                      Style="{StaticResource Button.Primary}" />
            </StackPanel>
          </StackPanel>
        </controls:ModernCard>
      </ScrollViewer>

      <!--  ============================================================
            Current weighment and the vehicles expected back
            ============================================================  -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Live Scale Weight HUD Card  -->
        <controls:ModernCard Grid.Row="0"
                             Margin="0,0,0,16"
                             Header="Live Scale Readout">
          <controls:ModernCard.HeaderActions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource Text.Caption}"
                         Text="{Binding CameraStatusText}" />
              <controls:StatusBadge Margin="0,0,6,0"
                                    Severity="{Binding StabilitySeverity}"
                                    Text="{Binding StabilityStatusText}" />
              <Border Padding="6,2"
                      Background="{DynamicResource Brush.Surface.Sunken}"
                      CornerRadius="{StaticResource Radius.SM}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LiveSourceText}" />
              </Border>
            </StackPanel>
          </controls:ModernCard.HeaderActions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Text.Label}" Text="Live weight on platform" />
              <Viewbox HorizontalAlignment="Left" MaxHeight="42" StretchDirection="DownOnly">
                <TextBlock AutomationProperties.Name="Live scale weight"
                           Style="{StaticResource Text.Numeric.Large}"
                           Text="{Binding LiveWeightDisplay}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
              </Viewbox>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <Button Margin="8,0,0,0"
                      Command="{Binding ReadIndicatorCommand}"
                      Content="Read indicator"
                      Style="{StaticResource Button.Secondary}"
                      ToolTip="Capture the settled weight from indicator into input field" />
            </StackPanel>
          </Grid>
        </controls:ModernCard>

        <!--  Status line: the operator's only report of what the last action did.  -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{StaticResource Radius.MD}"
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding HasStatus, Converter={StaticResource Converter.BooleanToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusLine.Accent}" />

            <TextBlock Grid.Column="1"
                       Margin="14,10,14,10"
                       Style="{StaticResource Text.Body.Wrapped}"
                       Text="{Binding StatusMessage}" />
          </Grid>
        </Border>

        <controls:ModernCard Grid.Row="2"
                             Header="Current weighment"
                             Visibility="{Binding HasCurrent, Converter={StaticResource Converter.BooleanToVisibility}}">
          <controls:ModernCard.HeaderActions>
            <controls:StatusBadge Severity="{Binding Current.StatusSeverity}" Text="{Binding Current.StatusText}" />
          </controls:ModernCard.HeaderActions>

          <StackPanel>
            <!--  Identity: slip number, vehicle, how it arrived.  -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Style="{StaticResource Text.Label}" Text="Slip" />
                <TextBlock Style="{StaticResource Text.Numeric.Emphasis}" Text="{Binding Current.SlipNumber}" />
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Current.VehicleNumber}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Current.ModeText}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Current.Details}" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,16,0,16" Style="{StaticResource Separator.Horizontal}" />

            <!--  The two figures that were weighed.  -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Text.Label}" Text="Gross (kg)" />
                <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding Current.GrossText}" />
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Text.Label}" Text="Tare (kg)" />
                <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding Current.TareText}" />
              </StackPanel>
            </Grid>

            <!--
              The figure the slip is about, on its own line and at the full width of the card.
              Inside a Viewbox because an ellipsised weight is worse than a small one: at the
              default window size a third of the card is 96px, and "20,249.5" at the display
              size needs 192px, so sharing a row with the other two rendered it as "20 , ...".
            -->
            <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Label}" Text="Net (kg)" />
            <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly">
              <TextBlock Style="{StaticResource Text.Numeric.Large}"
                         Text="{Binding Current.NetText}"
                         TextTrimming="None" />
            </Viewbox>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Current.ProvenanceText}"
                       Visibility="{Binding Current.ShowProvenance, Converter={StaticResource Converter.BooleanToVisibility}}" />

            <!--  Next step. Hidden once the weighment is closed.  -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding Current.IsOpen, Converter={StaticResource Converter.BooleanToVisibility}}">
              <Separator Margin="0,0,0,16" Style="{StaticResource Separator.Horizontal}" />

              <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Current.NextAction}" />

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Margin="0,0,0,4"
                             Style="{StaticResource Text.Label}"
                             Text="{Binding Current.WeightLabel}" />
                  <TextBox AutomationProperties.Name="Weight in kilograms"
                           Style="{StaticResource TextBox.Numeric}"
                           Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding ReadIndicatorCommand}"
                        Content="Read indicator"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Take the weight from the connected indicator" />

                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Command="{Binding RecordWeightCommand}"
                        Content="{Binding Current.ActionLabel}"
                        Style="{StaticResource Button.Primary}" />
              </Grid>

              <!--  Cancelling keeps the record, so it asks for a reason.  -->
              <Grid Margin="0,16,0,0" Visibility="{Binding CanCancel, Converter={StaticResource Converter.BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Margin="0,0,0,4"
                             Style="{StaticResource Text.Label}"
                             Text="Reason for cancelling" />
                  <TextBox AutomationProperties.Name="Reason for cancelling"
                           Style="{StaticResource TextBox.Default}"
                           Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding CancelWeighmentCommand}"
                        Content="Cancel weighment"
                        Style="{StaticResource Button.Danger}" />
              </Grid>
            </StackPanel>

            <!--  Finished state actions.  -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding Current.IsOpen, Converter={StaticResource Converter.InverseBooleanToVisibility}}">
              <Separator Margin="0,0,0,16" Style="{StaticResource Separator.Horizontal}" />

              <Button HorizontalAlignment="Left"
                      Command="{Binding PrintSlipCommand}"
                      Content="Print weighment slip"
                      Style="{StaticResource Button.Primary}" />
            </StackPanel>
          </StackPanel>
        </controls:ModernCard>

        <controls:ModernCard Grid.Row="2" Visibility="{Binding HasCurrent, Converter={StaticResource Converter.InverseBooleanToVisibility}}">
          <controls:EmptyState Icon="{StaticResource Icon.Scale}"
                               Message="Open a weighment on the left, or pick a vehicle from the waiting list below."
                               Title="No weighment in hand" />
        </controls:ModernCard>

        <controls:ModernCard Grid.Row="3"
                             Margin="0,16,0,0"
                             Header="Waiting for second weight"
                             Icon="{StaticResource Icon.Clock}"
                             SubHeader="Vehicles weighed once and expected back">
          <Grid>
            <DataGrid AutomationProperties.Name="Vehicles waiting for their second weight"
                      ItemsSource="{Binding AwaitingSecondWeight}"
                      SelectedItem="{Binding SelectedAwaiting}"
                      Style="{StaticResource DataGrid.Default}">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding VehicleNumber}"
                                    Header="Vehicle"
                                    Width="140" />
                <DataGridTextColumn Binding="{Binding SlipNumber}"
                                    Header="Slip"
                                    Width="110" />
                <DataGridTextColumn Binding="{Binding FirstWeightText}"
                                    Header="First weight (kg)"
                                    Width="130" />
                <DataGridTextColumn Binding="{Binding NextAction}"
                                    Header="Next"
                                    Width="*" />
                <DataGridTextColumn Binding="{Binding OpenedAtText}"
                                    Header="Opened"
                                    Width="140" />
              </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyState Icon="{StaticResource Icon.CheckMark}"
                                 Message="Every vehicle that has been weighed once has already been weighed twice."
                                 Style="{StaticResource Waiting.Empty}"
                                 Title="Nothing waiting" />
          </Grid>
        </controls:ModernCard>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
