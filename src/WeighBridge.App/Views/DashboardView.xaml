<UserControl x:Class="WeighBridge.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:DashboardViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             mc:Ignorable="d">

  <UserControl.Resources>
    <Style x:Key="StatusLine.Accent" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Default}" />
      <Setter Property="CornerRadius" Value="2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IndicatorSeverity}" Value="Information">
          <Setter Property="Background" Value="{DynamicResource Brush.Info.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IndicatorSeverity}" Value="Success">
          <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IndicatorSeverity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource Brush.Warning.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IndicatorSeverity}" Value="Danger">
          <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    
    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    
    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Large}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.Dashboard}"
                            ShowSeparator="True"
                            Title="{Binding Title}" />

    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>

      <!--  Left Column: Live Indicator & Metrics  -->
      <StackPanel Grid.Column="0">
        
        <controls:ModernCard Header="Live Indicator"
                             Icon="{StaticResource Icon.Scale}"
                             SubHeader="Real-time weight reading">
          <StackPanel>
            
            <Border Background="{DynamicResource Brush.Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.MD}"
                    Margin="0,0,0,16" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatusLine.Accent}" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="{Binding IndicatorStatus}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LiveWeight}" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
                            <TextBlock Text="{Binding LiveUnit}" FontSize="24" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
          </StackPanel>
        </controls:ModernCard>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <controls:ModernCard Grid.Column="0" Header="Today's Weighments">
                <StackPanel Margin="10">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="Completed today" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TodaysCompleted}" />
                </StackPanel>
            </controls:ModernCard>
            
            <controls:ModernCard Grid.Column="2" Header="Waiting Area">
                <StackPanel Margin="10">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="Vehicles inside" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CurrentlyWaiting}" />
                </StackPanel>
            </controls:ModernCard>
        </Grid>
      </StackPanel>

      <!--  Right Column: Shortcuts  -->
      <StackPanel Grid.Column="2">
        <controls:ModernCard Header="Shortcuts"
                             Icon="{StaticResource Icon.Forward}"
                             SubHeader="Quick access to common tasks">
            <StackPanel>
                <Button Command="{Binding OpenVehicleEntryCommand}"
                        Margin="0,0,0,10"
                        Padding="15"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource Button.Secondary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="{StaticResource Icon.Scale}" Margin="0,0,15,0" />
                        <TextBlock Text="Vehicle Entry" />
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding OpenReportsCommand}"
                        Padding="15"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource Button.Secondary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="{StaticResource Icon.Reports}" Margin="0,0,15,0" />
                        <TextBlock Text="Reports" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:ModernCard>
      </StackPanel>

    </Grid>
  </Grid>
</UserControl>
