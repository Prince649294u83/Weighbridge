<!--
  ModulePlaceholderView
  The single visual used by every module placeholder. Each module has its own view
  type so the naming convention ViewLocator relies on holds, and each of those hosts
  this control - so when a module is built, only its own view changes and the other
  six keep the shared placeholder.
-->
<UserControl x:Class="WeighBridge.App.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:ModulePlaceholderViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900">

  <UserControl.Resources>
    <converters:ResourceKeyConverter x:Key="Converter.ResourceKey" />
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0"
                            Title="{Binding Title}"
                            Description="{Binding Description}"
                            Icon="{Binding IconKey, Converter={StaticResource Converter.ResourceKey}}"
                            ShowSeparator="True">
      <controls:SectionHeader.Actions>
        <controls:StatusBadge Severity="Information" Text="{Binding Status}" />
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <controls:ModernCard Grid.Row="1" Margin="0,24,0,0">
      <controls:EmptyState Title="{Binding Status}"
                           Icon="{Binding IconKey, Converter={StaticResource Converter.ResourceKey}}"
                           Message="{Binding Description}" />
    </controls:ModernCard>
  </Grid>
</UserControl>
