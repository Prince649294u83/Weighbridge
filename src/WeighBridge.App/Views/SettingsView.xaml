<UserControl x:Class="WeighBridge.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
             d:DesignHeight="1200"
             d:DesignWidth="1100"
             mc:Ignorable="d">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Settings.BoolToVisibility" />
    <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
    <converters:BooleanToRadioButtonConverter x:Key="BoolToRadioConverter" />

    <Style x:Key="Settings.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Settings.Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="Settings.Field" TargetType="TextBox" BasedOn="{StaticResource TextBox.Default}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="280" />
    </Style>

    <Style x:Key="Settings.NumericField" TargetType="TextBox" BasedOn="{StaticResource TextBox.Numeric}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style x:Key="Settings.Choice" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Default}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="240" />
    </Style>

    <!-- Clean Modern TabItem Style -->
    <Style x:Key="Settings.TabItem" TargetType="TabItem">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    Margin="0,0,4,0"
                    CornerRadius="4,4,0,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary.Default}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Default}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  Header  -->
    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.Settings}"
                            ShowSeparator="True"
                            Title="{Binding Title}" />

    <!--  Main Settings TabControl (All 9 Functional Tabs)  -->
    <TabControl Grid.Row="1"
                Margin="0,16,0,16"
                SelectedIndex="{Binding SelectedTabIndex}"
                Background="{DynamicResource Brush.Surface.Default}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1">

      <!--  ============================================================
            1. EMAIL TAB
            ============================================================  -->
      <TabItem Header="Email" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Email" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding EmailEnabled, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding EmailEnabled, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Email Frequency" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Email only Final Entry" IsChecked="{Binding IsEmailFinalEntry}" GroupName="EmailFreq" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Email Both Entry" IsChecked="{Binding IsEmailBothEntry}" GroupName="EmailFreq" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Email PDF" />
              <CheckBox Grid.Column="1" IsChecked="{Binding EmailPdf}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
            </Grid>

            <!-- From Box -->
            <GroupBox Header="From" Margin="0,12,0,16" Padding="16" BorderBrush="{DynamicResource Brush.Border.Subtle}">
              <StackPanel>
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Sender Name" />
                  <TextBox Grid.Column="1" Text="{Binding EmailSenderName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Email ID" />
                  <TextBox Grid.Column="1" Text="{Binding EmailSenderId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Password" />
                  <PasswordBox Grid.Column="1"
                               controls:PasswordBoxBinding.BindPassword="True"
                               controls:PasswordBoxBinding.BoundPassword="{Binding EmailPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding CanEditConfiguration}"
                               Width="280"
                               HorizontalAlignment="Left" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="SMTP Server" />
                  <TextBox Grid.Column="1" Text="{Binding EmailSmtpServer, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="SMTP Port" />
                  <TextBox Grid.Column="1" Text="{Binding EmailSmtpPort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" Width="100" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Use SSL/TLS" />
                  <CheckBox Grid.Column="1" IsChecked="{Binding EmailUseSsl}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="1"
                          Content="Test SMTP Connection"
                          Command="{Binding TestEmailCommand}"
                          IsEnabled="{Binding CanEditConfiguration}"
                          Style="{StaticResource Button.Secondary}"
                          HorizontalAlignment="Left"
                          MinWidth="160" />
                </Grid>
              </StackPanel>
            </GroupBox>

            <!-- To Box -->
            <GroupBox Header="To" Margin="0,0,0,16" Padding="16" BorderBrush="{DynamicResource Brush.Border.Subtle}">
              <StackPanel>
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Email ID" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding NewRecipientEmail, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Width="240" Margin="0,0,8,0" Style="{StaticResource Settings.Field}" />
                    <Button Content="Add" Command="{Binding AddRecipientCommand}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Button.Secondary}" />
                  </StackPanel>
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Recipients List" />
                  <StackPanel Grid.Column="1">
                    <ListBox ItemsSource="{Binding RecipientEmails}" SelectedItem="{Binding SelectedRecipientEmail}" Height="90" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <Button Content="Delete" Command="{Binding DeleteRecipientCommand}" CommandParameter="{Binding SelectedRecipientEmail}" IsEnabled="{Binding CanEditConfiguration}" Width="80" HorizontalAlignment="Left" Style="{StaticResource Button.Text}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            2. PRINTING TAB
            ============================================================  -->
      <TabItem Header="Printing" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Enable Printing" />
              <CheckBox Grid.Column="1" IsChecked="{Binding PrintingEnabled}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Printer Type" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PrinterTypes}" SelectedItem="{Binding PrinterType}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Choice}" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Side Wise Printing" />
              <CheckBox Grid.Column="1" IsChecked="{Binding SideWisePrinting}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Default No. of Copies" />
              <TextBox Grid.Column="1" Text="{Binding CopyCount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Default Printer Name" />
              <TextBox Grid.Column="1" Text="{Binding DefaultPrinterName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Paper Size" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding PaperSize}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Choice}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            3. INPUT SETTINGS TAB
            ============================================================  -->
      <TabItem Header="Input Settings" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Unit Bags Weight Column" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding UnitBagsWeightColumn, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding UnitBagsWeightColumn, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Manual Tare Entry" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding ManualTareEntry, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding ManualTareEntry, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Auto Tare Weight" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding AutoTareWeight, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding AutoTareWeight, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="2nd Entry Charges" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding SecondEntryCharges, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding SecondEntryCharges, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="GST on Charges" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding GstOnCharges, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding GstOnCharges, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Only Single Entry (No Pending Slip)" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Enable" IsChecked="{Binding OnlySingleEntry, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,24,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding OnlySingleEntry, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            4. OTHER SETTINGS TAB
            ============================================================  -->
      <TabItem Header="Other Settings" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <Grid MaxWidth="900" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <StackPanel Grid.Column="0">
              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Price Computing" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding PriceComputing, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding PriceComputing, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Disconnect time" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <TextBox Text="{Binding DisconnectTimeSeconds, UpdateSourceTrigger=PropertyChanged}" Width="70" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" Margin="0,0,8,0" />
                  <TextBlock Text="sec" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Allow Zero Net Weight" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding AllowZeroNetWeight, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding AllowZeroNetWeight, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Auto Application Shortcut" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding AutoApplicationShortcut, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding AutoApplicationShortcut, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Auto Update Tare Weight" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding AutoUpdateTareWeight, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding AutoUpdateTareWeight, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Weight Hold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding WeightHold, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding WeightHold, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- Right Column -->
            <StackPanel Grid.Column="2">
              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Time Format" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="12 Hr" IsChecked="{Binding Is12HourFormat}" GroupName="OthTime" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="24 Hr" IsChecked="{Binding Is24HourFormat}" GroupName="OthTime" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Print QR Code" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding PrintQrCode, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding PrintQrCode, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Charges Mandatory" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Enable" IsChecked="{Binding ChargesMandatory, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                  <RadioButton Content="Disable" IsChecked="{Binding ChargesMandatory, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Settings.Label}" Text="Min. Charges" />
                <TextBox Grid.Column="1" Text="{Binding MinimumCharges, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
              </Grid>

              <!-- Legacy System Migration -->
              <GroupBox Header="Legacy System Migration" Margin="0,16,0,0" Padding="16" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                <StackPanel>
                  <TextBlock Text="Import historical tickets and master records from legacy Microsoft Access (.mdb, .accdb) or CSV files into the SQLite database." Style="{StaticResource Text.Secondary}" Margin="0,0,0,12" TextWrapping="Wrap" />
                  <Grid Style="{StaticResource Settings.Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Settings.Label}" Text="File Path" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBox Text="{Binding LegacyImportFilePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="340" />
                      <Button Content="Import Data" Command="{Binding ImportLegacyDataCommand}" IsEnabled="{Binding CanEditConfiguration}" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding LegacyImportStatus}" Foreground="{DynamicResource Brush.Text.Muted}" FontStyle="Italic" Margin="0,4,0,0" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            5. SMS TAB
            ============================================================  -->
      <TabItem Header="SMS" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="SMS Service" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Modem" IsChecked="{Binding IsSmsModem}" GroupName="SmsSvc" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="WhatsApp Web" IsChecked="{Binding IsSmsWhatsAppWeb}" GroupName="SmsSvc" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="WhatsApp API" IsChecked="{Binding IsSmsWhatsAppApi}" GroupName="SmsSvc" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="Disable" IsChecked="{Binding IsSmsDisabled}" GroupName="SmsSvc" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Message Frequency" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="SMS only Final Entry" IsChecked="{Binding IsSmsFinalEntry}" GroupName="SmsFreq" Margin="0,0,16,0" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
                <RadioButton Content="SMS Both Entry" IsChecked="{Binding IsSmsBothEntry}" GroupName="SmsFreq" IsEnabled="{Binding CanEditConfiguration}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="SMS Numbers" />
              <TextBox Grid.Column="1" Text="{Binding SmsNumbers, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="320" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="WhatsApp Token" />
              <TextBox Grid.Column="1" Text="{Binding WhatsAppToken, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="320" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            7. WEIGHT INDICATOR TAB
            ============================================================  -->
      <TabItem Header="Weight Indicator" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Left Column -->
              <StackPanel Grid.Column="0">
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Ending String" />
                  <TextBox Grid.Column="1" Text="{Binding IndicatorEndingString, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="160" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="No of Weight Digit" />
                  <TextBox Grid.Column="1" Text="{Binding WeightDigits, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Parity" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Choice}" Width="160" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Data bit" />
                  <TextBox Grid.Column="1" Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Stop Bit" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Choice}" Width="160" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="No of Digit to Remove from End" />
                  <TextBox Grid.Column="1" Text="{Binding TrailingDigitsRemoved, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Decimal" />
                  <TextBox Grid.Column="1" Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Stable Wait Time" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding IndicatorStableWaitTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" Width="60" Margin="0,0,8,0" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- Right Column -->
              <StackPanel Grid.Column="2">
                <CheckBox Content="Hex Value" IsChecked="{Binding IndicatorHexValue}" IsEnabled="{Binding CanEditConfiguration}" Margin="0,0,0,16" />
                <CheckBox Content="Reverse String" IsChecked="{Binding ReversePayload}" IsEnabled="{Binding CanEditConfiguration}" Margin="0,0,0,16" />
                <CheckBox Content="Essae Indicator (ES0D14)" IsChecked="{Binding IndicatorEssaeMode}" IsEnabled="{Binding CanEditConfiguration}" Margin="0,0,0,16" />
                <CheckBox Content="RTS/CTS" IsChecked="{Binding IndicatorRtsCts}" IsEnabled="{Binding CanEditConfiguration}" Margin="0,0,0,24" />

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Buffer Data" />
                  <TextBox Grid.Column="1" Text="{Binding IndicatorBufferData, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
                </Grid>

                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.Label}" Text="Dummy Zero" />
                  <TextBox Grid.Column="1" Text="{Binding IndicatorDummyZero, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" />
                </Grid>
              </StackPanel>
            </Grid>

            <!-- Test Connection Section -->
            <Border Background="{DynamicResource Brush.Surface.Raised}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="COM Port Test &amp; Verification" FontWeight="SemiBold" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Driver:" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{Binding DriverTypes}" SelectedItem="{Binding DriverType}" IsEnabled="{Binding CanEditConfiguration}" Width="120" Margin="0,0,12,0" />
                  <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding CanEditConfiguration}" Width="140" Margin="0,0,12,0" />
                  <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" IsEnabled="{Binding CanEditConfiguration}" Width="120" Margin="0,0,12,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                  <Button Content="Refresh Ports" Command="{Binding RefreshPortsCommand}" Style="{StaticResource Button.Text}" />
                </StackPanel>
                <TextBlock Text="{Binding ConnectionTestStatus}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            8. PORT SETTINGS TAB
            ============================================================  -->
      <TabItem Header="Port Settings" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <!-- Receive Serial Port 1 -->
            <GroupBox Header="Receive Serial Port 1" Margin="0,0,0,20" Padding="16" BorderBrush="{DynamicResource Brush.Border.Subtle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}" Text="COM Port" Margin="0,0,0,12" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding ReceivePort1Name}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource Settings.Choice}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}" Text="Baud Rate" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding ReceivePort1Baud}" Width="160" HorizontalAlignment="Left" Style="{StaticResource Settings.Choice}" />
              </Grid>
            </GroupBox>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Receive Serial Port 2 -->
              <GroupBox Grid.Column="0" Header="Receive Serial Port 2" Padding="16" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}" Text="COM Port" Margin="0,0,0,12" />
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding ReceivePort2Name}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource Settings.Choice}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}" Text="Baud Rate" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding ReceivePort2Baud}" Width="140" HorizontalAlignment="Left" Style="{StaticResource Settings.Choice}" />
                </Grid>
              </GroupBox>

              <!-- Send Data Port -->
              <GroupBox Grid.Column="2" Header="Send Data Port" Padding="16" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}" Text="COM Port" Margin="0,0,0,12" />
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SendDataPortName}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource Settings.Choice}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}" Text="Baud Rate" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SendDataPortBaud}" Width="140" HorizontalAlignment="Left" Style="{StaticResource Settings.Choice}" />
                </Grid>
              </GroupBox>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            9. WB NAME FEEDING TAB
            ============================================================  -->
      <TabItem Header="WB Name Feeding" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Weighbridge Name" />
              <TextBox Grid.Column="1" Text="{Binding WeighbridgeName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Weighbridge Address 1" />
              <TextBox Grid.Column="1" Text="{Binding WeighbridgeAddress1, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Weighbridge Address 2" />
              <TextBox Grid.Column="1" Text="{Binding WeighbridgeAddress2, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Phone" />
              <TextBox Grid.Column="1" Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Email" />
              <TextBox Grid.Column="1" Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="GSTIN / Tax ID" />
              <TextBox Grid.Column="1" Text="{Binding CompanyTaxId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            9. APPEARANCE TAB
            ============================================================  -->
      <TabItem Header="Appearance" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Application Theme" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" Style="{StaticResource Settings.Choice}" Width="240" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Command="{Binding SavePreferencesCommand}" Content="Save Theme Preference" Padding="16,8" Style="{StaticResource Button.Primary}" />
              <Button Command="{Binding ResetPreferencesCommand}" Content="Reset to Default" Padding="16,8" Margin="16,0,0,0" Style="{StaticResource Button.Text}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  ============================================================
            10. REPORTING TAB
            ============================================================  -->
      <TabItem Header="Reporting" Style="{StaticResource Settings.TabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
          <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Report Output Directory" />
              <TextBox Grid.Column="1" Text="{Binding ReportOutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.Field}" Width="360" />
            </Grid>

            <Grid Style="{StaticResource Settings.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Settings.Label}" Text="Max Rows Per Report" />
              <TextBox Grid.Column="1" Text="{Binding MaxRowsPerReport, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfiguration}" Style="{StaticResource Settings.NumericField}" Width="160" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!--  Bottom Global Action Bar with [ Save Changes ] Button  -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.MD}"
            Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button AutomationProperties.Name="Discard Changes"
                Command="{Binding DiscardConfigurationCommand}"
                Margin="0,0,12,0"
                Style="{StaticResource Button.Text}">
          <TextBlock Text="Discard Changes" />
        </Button>
        <Button AutomationProperties.Name="Save Changes"
                Command="{Binding SaveConfigurationCommand}"
                Style="{StaticResource Button.Primary}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Icon.Save}" Margin="0,0,6,0" FontSize="14" />
            <TextBlock Text="Save Changes" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
