<UserControl x:Class="WeighBridge.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ReportsViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             mc:Ignorable="d">

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />

    <Style x:Key="StatusLine.Accent" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Default}" />
      <Setter Property="CornerRadius" Value="2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Information">
          <Setter Property="Background" Value="{DynamicResource Brush.Info.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
          <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource Brush.Warning.Default}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusSeverity}" Value="Danger">
          <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Field.Label"
           BasedOn="{StaticResource Text.Label}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.Reports}"
                            ShowSeparator="True"
                            Title="{Binding Title}" />

    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  Parameters  -->
      <ScrollViewer Grid.Column="0"
                    Style="{StaticResource ScrollViewer.Default}"
                    VerticalScrollBarVisibility="Auto">
        <controls:ModernCard Header="Parameters"
                             Icon="{StaticResource Icon.Filter}"
                             SubHeader="Report criteria">
          <StackPanel>
            <TextBlock Style="{StaticResource Field.Label}" Text="Report Type" />
            <ComboBox ItemsSource="{Binding AvailableReports}"
                      SelectedItem="{Binding SelectedReport}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Start Date" />
            <DatePicker SelectedDate="{Binding StartDate}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="End Date" />
            <DatePicker SelectedDate="{Binding EndDate}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Party Name (Optional)" />
            <TextBox Style="{StaticResource TextBox.Default}"
                     Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Field.Label}" Text="Material Name (Optional)" />
            <TextBox Style="{StaticResource TextBox.Default}"
                     Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button Command="{Binding GenerateCommand}"
                      Content="Generate CSV"
                      Style="{StaticResource Button.Primary}" />
            </StackPanel>
          </StackPanel>
        </controls:ModernCard>
      </ScrollViewer>

      <!--  Result Status  -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Status line  -->
        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{StaticResource Radius.MD}"
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding HasStatus, Converter={StaticResource Converter.BooleanToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusLine.Accent}" />

            <TextBlock Grid.Column="1"
                       Margin="14,10,14,10"
                       Style="{StaticResource Text.Body.Wrapped}"
                       Text="{Binding StatusMessage}" />
                       
            <Button Grid.Column="2" 
                    Margin="10"
                    Command="{Binding OpenFolderCommand}"
                    Content="Show in Explorer"
                    Style="{StaticResource Button.Text}" />
          </Grid>
        </Border>

        <controls:ModernCard Grid.Row="1"
                             Header="Report Information"
                             Icon="{StaticResource Icon.Information}"
                             SubHeader="Generated outputs">
                             
            <TextBlock Style="{StaticResource Text.Body.Wrapped}" 
                       Text="When a report is generated, it is saved to the configured output directory as a CSV file. You can open it in Excel or any spreadsheet software." />
        </controls:ModernCard>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
