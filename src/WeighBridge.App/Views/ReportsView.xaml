<UserControl x:Class="WeighBridge.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeighBridge.App.Controls"
             xmlns:converters="clr-namespace:WeighBridge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WeighBridge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ReportsViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             mc:Ignorable="d">

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />

    <Style x:Key="Field.Label"
           BasedOn="{StaticResource Text.Label}"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Thickness.PageContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Header  -->
    <controls:SectionHeader Grid.Row="0"
                            Description="{Binding Description}"
                            Icon="{StaticResource Icon.Reports}"
                            ShowSeparator="True"
                            Title="{Binding Title}" />

    <!--  Main Content Area  -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="480" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  Left: 8 Filter Inputs (Screenshot 2 Parity)  -->
      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Surface.Raised}"
              BorderBrush="{DynamicResource Brush.Border.Default}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.MD}"
              Padding="16,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.H3}" Text="Report Criteria" Margin="0,0,0,12" />

            <!--  Starting Slip No.  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Starting Slip No." />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Starting Slip No"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding StartSlipInput, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Ending Slip No.  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Ending Slip No." />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="Ending Slip No"
                       Style="{StaticResource TextBox.Default}"
                       Text="{Binding EndSlipInput, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Start Date  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Start Date" />
              <DatePicker Grid.Column="1"
                          AutomationProperties.Name="Start Date"
                          SelectedDate="{Binding StartDate}" />
            </Grid>

            <!--  End Date  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="End Date" />
              <DatePicker Grid.Column="1"
                          AutomationProperties.Name="End Date"
                          SelectedDate="{Binding EndDate}" />
            </Grid>

            <!--  Vehicle No.  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Vehicle No." />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Vehicle No"
                        IsEditable="True"
                        ItemsSource="{Binding AvailableVehicles}"
                        Text="{Binding VehicleNumber, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Party Name  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Party Name" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Party Name"
                        IsEditable="True"
                        ItemsSource="{Binding AvailableParties}"
                        Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Material  -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Material" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Material"
                        IsEditable="True"
                        ItemsSource="{Binding AvailableMaterials}"
                        Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Vehicle Type  -->
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Vehicle Type" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Vehicle Type"
                        IsEditable="True"
                        ItemsSource="{Binding AvailableVehicleTypes}"
                        Text="{Binding VehicleTypeName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBox.Default}" />
            </Grid>

            <!--  Divider  -->
            <Separator Margin="0,4,0,12" Background="{DynamicResource Brush.Border.Subtle}" />

            <!--  Action Buttons (Screenshot 2 Parity)  -->
            <StackPanel Margin="0,4,0,0">
              <Button AutomationProperties.Name="View Report"
                      Command="{Binding ViewReportCommand}"
                      Style="{StaticResource Button.Primary}"
                      Margin="0,0,0,8"
                      ToolTip="Open modal Report Preview window">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Icon.Document}" Margin="0,0,6,0" FontSize="14" />
                  <TextBlock Text="View Report" FontWeight="Bold" />
                </StackPanel>
              </Button>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        AutomationProperties.Name="Print"
                        Command="{Binding PrintCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Print report to default printer">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Icon.Print}" Margin="0,0,6,0" FontSize="14" />
                    <TextBlock Text="Print" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        AutomationProperties.Name="Email"
                        Command="{Binding EmailCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Email report document">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Icon.Email}" Margin="0,0,6,0" FontSize="14" />
                    <TextBlock Text="Email" />
                  </StackPanel>
                </Button>
              </Grid>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        AutomationProperties.Name="Export as Excel"
                        Command="{Binding ExportExcelCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Export report to Excel (.xlsx)">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Icon.Export}" Margin="0,0,6,0" FontSize="14" />
                    <TextBlock Text="Export as Excel" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        AutomationProperties.Name="Export as PDF"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Export report to PDF (.pdf)">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Icon.Document}" Margin="0,0,6,0" FontSize="14" />
                    <TextBlock Text="Export as PDF" />
                  </StackPanel>
                </Button>
              </Grid>

              <Button AutomationProperties.Name="Clear Filters"
                      Command="{Binding ClearFiltersCommand}"
                      Style="{StaticResource Button.Text}"
                      HorizontalAlignment="Center"
                      ToolTip="Reset all filter fields">
                <TextBlock Text="Clear Filters" />
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!--  Right: Instructions / Status  -->
      <Border Grid.Column="2"
              Background="{DynamicResource Brush.Surface.Raised}"
              BorderBrush="{DynamicResource Brush.Border.Default}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.MD}"
              Padding="24,20">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.H3}" Text="Reporting Instructions" Margin="0,0,0,12" />
          <TextBlock Style="{StaticResource Text.Body}"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     TextWrapping="Wrap"
                     LineHeight="22"
                     Margin="0,0,0,16"
                     Text="Use the criteria on the left to filter completed transactions. You can filter by slip number range, date range, or specific vehicle, party, material, and vehicle type." />

          <TextBlock Style="{StaticResource Text.Body}"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     TextWrapping="Wrap"
                     LineHeight="22"
                     Margin="0,0,0,16"
                     Text="• Starting / Ending Slip: accepts sequence numbers (e.g. 1, 000042, WB-000042)&#x0a;• Text Filters: partial / contains matching is performed&#x0a;• View Report: opens a full-width monospace preview matching the dot-matrix slip format&#x0a;• Export: downloads an Excel (.xlsx) or PDF (.pdf) file directly." />

          <!--  Status Message  -->
          <Border Margin="0,16,0,0"
                  Padding="16,12"
                  Background="{DynamicResource Brush.Surface.Sunken}"
                  CornerRadius="{StaticResource Radius.SM}"
                  Visibility="{Binding HasStatus, Converter={StaticResource Converter.BooleanToVisibility}}">
            <TextBlock Style="{StaticResource Text.Body}"
                       FontWeight="SemiBold"
                       Text="{Binding StatusMessage}" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
