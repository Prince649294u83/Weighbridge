<!--
    Design tokens: spacing, radii, typography and elevation.

    Theme-independent values live here so the light and dark dictionaries only ever
    differ by colour. Spacing follows a strict 8px scale.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  ===== Spacing: 8px scale =====  -->
    <sys:Double x:Key="Space.0">0</sys:Double>
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">24</sys:Double>
    <sys:Double x:Key="Space.6">32</sys:Double>
    <sys:Double x:Key="Space.7">40</sys:Double>
    <sys:Double x:Key="Space.8">48</sys:Double>

    <Thickness x:Key="Thickness.None">0</Thickness>
    <Thickness x:Key="Thickness.XS">4</Thickness>
    <Thickness x:Key="Thickness.SM">8</Thickness>
    <Thickness x:Key="Thickness.MD">16</Thickness>
    <Thickness x:Key="Thickness.LG">24</Thickness>
    <Thickness x:Key="Thickness.XL">32</Thickness>

    <Thickness x:Key="Thickness.Button">16,8</Thickness>
    <Thickness x:Key="Thickness.Card">20</Thickness>
    <Thickness x:Key="Thickness.Input">12,8</Thickness>
    <Thickness x:Key="Thickness.PageContent">24</Thickness>

    <!--  ===== Corner radii: 10px is the house style =====  -->
    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Radius.SM">6</CornerRadius>
    <CornerRadius x:Key="Radius.MD">10</CornerRadius>
    <CornerRadius x:Key="Radius.LG">14</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <!--  Focus rings are drawn 3px outside a Radius.MD element, so they need 3px more curve.  -->
    <CornerRadius x:Key="Radius.MD.Focus">13</CornerRadius>

    <!--  ===== Typography =====  -->
    <!--
        Segoe UI Variable is the Windows 11 default; Segoe UI is the Windows 10
        fallback. WPF resolves the first family that exists on the machine.
    -->
    <FontFamily x:Key="Font.Primary">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.Small">12</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.BodyLarge">14</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">16</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>
    <sys:Double x:Key="Font.Size.TitleLarge">28</sys:Double>
    <sys:Double x:Key="Font.Size.Display">40</sys:Double>
    <sys:Double x:Key="Font.Size.Icon">16</sys:Double>
    <sys:Double x:Key="Font.Size.IconLarge">20</sys:Double>

    <!--  ===== Control metrics =====  -->
    <sys:Double x:Key="Size.TitleBarHeight">48</sys:Double>
    <sys:Double x:Key="Size.StatusBarHeight">32</sys:Double>
    <sys:Double x:Key="Size.NavigationWidth">248</sys:Double>
    <sys:Double x:Key="Size.NavigationCollapsedWidth">56</sys:Double>
    <sys:Double x:Key="Size.NavigationItemHeight">44</sys:Double>
    <sys:Double x:Key="Size.BottomNavigationHeight">74</sys:Double>
    <sys:Double x:Key="Size.BottomNavigationItemHeight">68</sys:Double>
    <sys:Double x:Key="Font.Size.NavigationIcon">26</sys:Double>
    <sys:Double x:Key="Size.ControlHeight">36</sys:Double>
    <sys:Double x:Key="Size.ControlHeightLarge">44</sys:Double>
    <sys:Double x:Key="Size.WindowButtonWidth">46</sys:Double>
    <sys:Double x:Key="Size.StatusDot">9</sys:Double>
    <sys:Double x:Key="Size.DataGridRowHeight">40</sys:Double>
    <sys:Double x:Key="Size.MinWindowWidth">800</sys:Double>
    <sys:Double x:Key="Size.MinWindowHeight">480</sys:Double>

    <!--  ===== Animation durations =====  -->
    <Duration x:Key="Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Duration.Normal">0:0:0.2</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.35</Duration>

</ResourceDictionary>
