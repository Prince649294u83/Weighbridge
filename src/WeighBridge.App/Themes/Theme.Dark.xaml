<!--
    Dark theme: same key set as Theme.Light.xaml, different colour mapping.

    Tuned for night-shift cabin use — surfaces stay dark enough to avoid glare while
    text keeps a WCAG AA contrast ratio against them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WeighBridge.App;component/Themes/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ===== Surfaces =====  -->
    <SolidColorBrush x:Key="Brush.Surface.Window" Color="{StaticResource Neutral.100}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Neutral.90}" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Neutral.80}" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Neutral.95}" />
    <SolidColorBrush x:Key="Brush.Surface.TitleBar" Color="{StaticResource Neutral.90}" />
    <SolidColorBrush x:Key="Brush.Surface.Navigation" Color="{StaticResource Neutral.95}" />
    <SolidColorBrush x:Key="Brush.Surface.StatusBar" Color="{StaticResource Neutral.90}" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="#99000000" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Neutral.80}" />
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Neutral.70}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Primary.100}" />
    <SolidColorBrush x:Key="Brush.Surface.Disabled" Color="{StaticResource Neutral.80}" />

    <!--  ===== Text =====  -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Neutral.5}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Neutral.40}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Neutral.50}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Neutral.60}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Neutral.0}" />
    <SolidColorBrush x:Key="Brush.Text.Accent" Color="{StaticResource Primary.40}" />
    <SolidColorBrush x:Key="Brush.Text.Placeholder" Color="{StaticResource Neutral.50}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Neutral.50}" />

    <!--  ===== Borders =====  -->
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Neutral.70}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Neutral.60}" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Neutral.80}" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Primary.50}" />
    <SolidColorBrush x:Key="Brush.Border.Accent" Color="{StaticResource Primary.60}" />

    <!--  ===== Accent / Primary action =====  -->
    <SolidColorBrush x:Key="Brush.Accent.Default" Color="{StaticResource Primary.60}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Primary.50}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Primary.70}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Primary.100}" />
    <SolidColorBrush x:Key="Brush.Accent.Disabled" Color="{StaticResource Primary.90}" />
    <SolidColorBrush x:Key="Brush.Primary.Default" Color="{StaticResource Primary.60}" />
    <SolidColorBrush x:Key="Brush.Primary.Dark" Color="{StaticResource Primary.70}" />

    <!--  ===== Semantic states =====  -->
    <SolidColorBrush x:Key="Brush.Success.Default" Color="{StaticResource Success.60}" />
    <SolidColorBrush x:Key="Brush.Success.Hover" Color="{StaticResource Success.50}" />
    <SolidColorBrush x:Key="Brush.Success.Pressed" Color="{StaticResource Success.70}" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#0F2A22" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="{StaticResource Success.50}" />

    <SolidColorBrush x:Key="Brush.Warning.Default" Color="{StaticResource Warning.60}" />
    <SolidColorBrush x:Key="Brush.Warning.Hover" Color="{StaticResource Warning.50}" />
    <SolidColorBrush x:Key="Brush.Warning.Pressed" Color="{StaticResource Warning.70}" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#2B2110" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="{StaticResource Warning.50}" />

    <SolidColorBrush x:Key="Brush.Danger.Default" Color="{StaticResource Danger.60}" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{StaticResource Danger.50}" />
    <SolidColorBrush x:Key="Brush.Danger.Pressed" Color="{StaticResource Danger.70}" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#2C1416" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="{StaticResource Danger.50}" />

    <SolidColorBrush x:Key="Brush.Info.Default" Color="{StaticResource Info.60}" />
    <SolidColorBrush x:Key="Brush.Info.Subtle" Color="#101C33" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="{StaticResource Info.50}" />

    <SolidColorBrush x:Key="Brush.Neutral.Default" Color="{StaticResource Neutral.50}" />
    <SolidColorBrush x:Key="Brush.Neutral.Subtle" Color="{StaticResource Neutral.80}" />

    <!--  ===== Document / Paper: intentionally light for printable document readability =====  -->
    <SolidColorBrush x:Key="Brush.Paper.Background" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Brush.Paper.Text" Color="#1A1A1A" />

    <!--  ===== Window control buttons =====  -->
    <SolidColorBrush x:Key="Brush.WindowButton.Hover" Color="{StaticResource Neutral.80}" />
    <SolidColorBrush x:Key="Brush.WindowButton.Pressed" Color="{StaticResource Neutral.70}" />
    <SolidColorBrush x:Key="Brush.WindowButton.CloseHover" Color="{StaticResource Danger.60}" />
    <SolidColorBrush x:Key="Brush.WindowButton.ClosePressed" Color="{StaticResource Danger.80}" />

    <!--  ===== Elevation: deeper shadows read better on dark surfaces =====  -->
    <DropShadowEffect x:Key="Elevation.Card"
                      BlurRadius="16"
                      Direction="270"
                      Opacity="0.40"
                      ShadowDepth="2"
                      Color="#000000" />

    <DropShadowEffect x:Key="Elevation.Raised"
                      BlurRadius="24"
                      Direction="270"
                      Opacity="0.50"
                      ShadowDepth="4"
                      Color="#000000" />

    <DropShadowEffect x:Key="Elevation.Dialog"
                      BlurRadius="40"
                      Direction="270"
                      Opacity="0.65"
                      ShadowDepth="8"
                      Color="#000000" />

</ResourceDictionary>
