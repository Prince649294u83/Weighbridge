<!--
    Segoe Fluent Icons glyph codes, referenced by name so no view ever hard-codes a
    private-use codepoint. Glyphs fall back to Segoe MDL2 Assets on Windows 10 —
    every code below exists in both fonts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  ===== Navigation modules =====  -->
    <sys:String x:Key="Icon.Dashboard">&#xE80F;</sys:String>
    <sys:String x:Key="Icon.VehicleEntry">&#xE804;</sys:String>
    <sys:String x:Key="Icon.DuplicateSlip">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Reports">&#xE9F9;</sys:String>
    <sys:String x:Key="Icon.Masters">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Administration">&#xE7EF;</sys:String>

    <!--  ===== Window controls =====  -->
    <sys:String x:Key="Icon.Minimize">&#xE921;</sys:String>
    <sys:String x:Key="Icon.Maximize">&#xE922;</sys:String>
    <sys:String x:Key="Icon.Restore">&#xE923;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE8BB;</sys:String>

    <!--  ===== Navigation commands =====  -->
    <sys:String x:Key="Icon.Back">&#xE72B;</sys:String>
    <sys:String x:Key="Icon.Forward">&#xE72A;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Menu">&#xE700;</sys:String>
    <sys:String x:Key="Icon.ChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.SortAscending">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.SortDescending">&#xE70D;</sys:String>

    <!--  ===== Dialog and status severity =====  -->
    <sys:String x:Key="Icon.Information">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Success">&#xE930;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icon.Question">&#xE9CE;</sys:String>
    <sys:String x:Key="Icon.CheckMark">&#xE73E;</sys:String>

    <!--  ===== General purpose =====  -->
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Clear">&#xE711;</sys:String>
    <sys:String x:Key="Icon.User">&#xE77B;</sys:String>
    <sys:String x:Key="Icon.Calendar">&#xE787;</sys:String>
    <sys:String x:Key="Icon.Clock">&#xE823;</sys:String>
    <sys:String x:Key="Icon.Theme">&#xE793;</sys:String>
    <sys:String x:Key="Icon.Database">&#xE81E;</sys:String>
    <sys:String x:Key="Icon.Scale">&#xE9D9;</sys:String>
    <sys:String x:Key="Icon.Printer">&#xE749;</sys:String>
    <sys:String x:Key="Icon.Server">&#xE968;</sys:String>
    <sys:String x:Key="Icon.Application">&#xECAA;</sys:String>
    <sys:String x:Key="Icon.EmptyState">&#xE7C3;</sys:String>
    <sys:String x:Key="Icon.Construction">&#xE912;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Cancel">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Copy">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Export">&#xEDE1;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>

</ResourceDictionary>
