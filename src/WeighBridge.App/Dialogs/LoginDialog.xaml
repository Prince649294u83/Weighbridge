<dialogs:DialogWindowBase x:Class="WeighBridge.App.Dialogs.LoginDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:dialogs="clr-namespace:WeighBridge.App.Dialogs"
                          xmlns:converters="clr-namespace:WeighBridge.App.Converters"
                          mc:Ignorable="d"
                          d:DataContext="{d:DesignInstance Type=dialogs:LoginDialogViewModel}"
                          Title="{Binding WindowTitle}"
                          Width="460"
                          MinHeight="250">

  <Window.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
  </Window.Resources>

  <Border Margin="16"
          Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.LG}"
          Effect="{DynamicResource Elevation.Dialog}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  Header: title, message  -->
      <Grid Grid.Row="0"
            Margin="24,24,24,16"
            Background="Transparent"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderText}" />
          <TextBlock Margin="0,8,0,0"
                     Style="{StaticResource Text.Body.Wrapped}"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     Text="{Binding PromptText}" />
        </StackPanel>
      </Grid>

      <!--  Form fields  -->
      <StackPanel Grid.Row="1" Margin="24,0,24,16">

        <TextBlock Text="Username" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />
        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Password" Style="{StaticResource Text.Body}" Margin="0,16,0,4" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />

        <!--  Shown only while appointing the first administrator  -->
        <StackPanel Visibility="{Binding IsInitialSetup, Converter={StaticResource Converter.BooleanToVisibility}}">
          <TextBlock Text="Confirm password" Style="{StaticResource Text.Body}" Margin="0,16,0,4" />
          <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnPasswordChanged" />
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Margin="0,16,0,0"
                   Foreground="{DynamicResource Brush.Danger.Text}"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource Converter.BooleanToVisibility}}"
                   TextWrapping="Wrap" />

      </StackPanel>

      <!--  Command bar  -->
      <Border Grid.Row="2"
              Padding="24,16"
              Background="{DynamicResource Brush.Surface.Sunken}"
              CornerRadius="0,0,14,14">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="CancelButton"
                  MinWidth="96"
                  Margin="0,0,12,0"
                  Style="{StaticResource Button.Secondary}"
                  Click="OnCancelClicked"
                  Content="Exit"
                  IsCancel="True" />

          <Button x:Name="LoginButton"
                  MinWidth="96"
                  Click="OnLoginClicked"
                  Content="{Binding SubmitLabel}"
                  IsDefault="True"
                  Style="{StaticResource Button.Primary}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</dialogs:DialogWindowBase>
