<dialogs:DialogWindowBase x:Class="WeighBridge.App.Dialogs.LoginDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:dialogs="clr-namespace:WeighBridge.App.Dialogs"
                          xmlns:converters="clr-namespace:WeighBridge.App.Converters"
                          mc:Ignorable="d"
                          d:DataContext="{d:DesignInstance Type=dialogs:LoginDialogViewModel}"
                          Title="{Binding WindowTitle}"
                          Width="460"
                          MinHeight="250">

  <Window.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <StreamGeometry x:Key="Geometry.Eye">M 12,4.5 C 7,4.5 2.73,7.61 1,12 C 2.73,16.39 7,19.5 12,19.5 C 17,19.5 21.27,16.39 23,12 C 21.27,7.61 17,4.5 12,4.5 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,9.24 9.24,7 12,7 C 14.76,7 17,9.24 17,12 C 17,14.76 14.76,17 12,17 Z M 12,9 C 10.34,9 9,10.34 9,12 C 9,13.66 10.34,15 12,15 C 13.66,15 15,13.66 15,12 C 15,10.34 13.66,9 12,9 Z</StreamGeometry>
    <StreamGeometry x:Key="Geometry.EyeSlash">M 12,7 C 13.66,7 15,8.34 15,10 C 15,10.64 14.79,11.23 14.44,11.71 L 16.03,13.3 C 16.64,12.36 17,11.23 17,10 C 17,7.24 14.76,5 12,5 C 10.77,5 9.64,5.36 8.7,5.97 L 10.29,7.56 C 10.77,7.21 11.36,7 12,7 Z M 2.71,3.29 C 2.32,2.9 1.69,2.9 1.3,3.29 C 0.91,3.68 0.91,4.31 1.3,4.7 L 3.27,6.67 C 1.93,8.08 1,9.88 1,12 C 2.73,16.39 7,19.5 12,19.5 C 13.91,19.5 15.69,18.94 17.2,17.98 L 19.3,20.08 C 19.69,20.47 20.32,20.47 20.71,20.08 C 21.1,19.69 21.1,19.06 20.71,18.67 L 2.71,3.29 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,11.13 7.22,10.31 7.61,9.6 L 13.4,15.39 C 12.98,15.78 12.43,16 12,16 Z</StreamGeometry>
  </Window.Resources>

  <Border Margin="16"
          Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.LG}"
          Effect="{DynamicResource Elevation.Dialog}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  Header: title, message  -->
      <Grid Grid.Row="0"
            Margin="24,24,24,16"
            Background="Transparent"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderText}" />
          <TextBlock Margin="0,8,0,0"
                     Style="{StaticResource Text.Body.Wrapped}"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     Text="{Binding PromptText}" />
        </StackPanel>
      </Grid>

      <!--  Form fields  -->
      <StackPanel Grid.Row="1" Margin="24,0,24,16">

        <TextBlock Text="Username" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />
        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Password" Style="{StaticResource Text.Body}" Margin="0,16,0,4" />
        <Grid>
          <PasswordBox x:Name="PasswordBox"
                       Padding="8,0,36,0"
                       PasswordChanged="OnPasswordChanged" />
          <TextBox x:Name="VisiblePasswordBox"
                   Padding="8,0,36,0"
                   Visibility="Collapsed"
                   TextChanged="OnVisiblePasswordChanged" />
          <Button x:Name="TogglePasswordButton"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Width="30"
                  Height="30"
                  Margin="0,0,3,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Focusable="False"
                  Click="OnTogglePasswordVisibilityClicked"
                  ToolTip="Show / Hide password">
            <Viewbox Width="16" Height="16">
              <Path x:Name="PasswordEyeIcon"
                    Fill="{DynamicResource Brush.Text.Secondary}"
                    Data="{StaticResource Geometry.Eye}" />
            </Viewbox>
          </Button>
        </Grid>

        <!--  Shown only while appointing the first administrator  -->
        <StackPanel Visibility="{Binding IsInitialSetup, Converter={StaticResource Converter.BooleanToVisibility}}">
          <TextBlock Text="Confirm password" Style="{StaticResource Text.Body}" Margin="0,16,0,4" />
          <Grid>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Padding="8,0,36,0"
                         PasswordChanged="OnConfirmPasswordChanged" />
            <TextBox x:Name="VisibleConfirmPasswordBox"
                     Padding="8,0,36,0"
                     Visibility="Collapsed"
                     TextChanged="OnVisibleConfirmPasswordChanged" />
            <Button x:Name="ToggleConfirmPasswordButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="30"
                    Height="30"
                    Margin="0,0,3,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    Click="OnToggleConfirmPasswordVisibilityClicked"
                    ToolTip="Show / Hide password">
              <Viewbox Width="16" Height="16">
                <Path x:Name="ConfirmPasswordEyeIcon"
                      Fill="{DynamicResource Brush.Text.Secondary}"
                      Data="{StaticResource Geometry.Eye}" />
              </Viewbox>
            </Button>
          </Grid>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Margin="0,16,0,0"
                   Foreground="{DynamicResource Brush.Danger.Text}"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource Converter.BooleanToVisibility}}"
                   TextWrapping="Wrap" />

      </StackPanel>

      <!--  Command bar  -->
      <Border Grid.Row="2"
              Padding="24,16"
              Background="{DynamicResource Brush.Surface.Sunken}"
              CornerRadius="0,0,14,14">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="CancelButton"
                  MinWidth="96"
                  Margin="0,0,12,0"
                  Style="{StaticResource Button.Secondary}"
                  Click="OnCancelClicked"
                  Content="Exit"
                  IsCancel="True" />

          <Button x:Name="LoginButton"
                  MinWidth="96"
                  Click="OnLoginClicked"
                  Content="{Binding SubmitLabel}"
                  IsDefault="True"
                  Style="{StaticResource Button.Primary}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</dialogs:DialogWindowBase>
