<dialogs:DialogWindowBase x:Class="WeighBridge.App.Dialogs.ProgressDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:controls="clr-namespace:WeighBridge.App.Controls"
                          xmlns:converters="clr-namespace:WeighBridge.App.Converters"
                          xmlns:dialogs="clr-namespace:WeighBridge.App.Dialogs"
                          mc:Ignorable="d"
                          d:DataContext="{d:DesignInstance Type=dialogs:ProgressDialogViewModel}"
                          Title="{Binding Title}"
                          Width="420">

  <Window.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="Converter.InverseBooleanToVisibility" />
  </Window.Resources>

  <Border Margin="16"
          Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.LG}"
          Effect="{DynamicResource Elevation.Dialog}">
    <StackPanel Margin="24">
      <TextBlock Style="{StaticResource Text.Subtitle}"
                 Text="{Binding Title}"
                 TextWrapping="Wrap" />

      <!--  Indeterminate work shows the spinner; measurable work shows the bar.  -->
      <controls:LoadingSpinner Margin="0,20,0,0"
                               Diameter="36"
                               IsActive="{Binding IsIndeterminate}"
                               Visibility="{Binding IsIndeterminate, Converter={StaticResource Converter.BooleanToVisibility}}" />

      <Grid Margin="0,20,0,0"
            Visibility="{Binding IsIndeterminate, Converter={StaticResource Converter.InverseBooleanToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ProgressBar Grid.Column="0"
                     VerticalAlignment="Center"
                     Style="{StaticResource ProgressBar.Default}"
                     Maximum="100"
                     Minimum="0"
                     Value="{Binding Percentage, Mode=OneWay}" />

        <TextBlock Grid.Column="1"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Numeric}"
                   Text="{Binding Percentage, StringFormat={}{0:F0} %}" />
      </Grid>

      <TextBlock Margin="0,16,0,0"
                 HorizontalAlignment="Center"
                 Style="{StaticResource Text.Secondary.Wrapped}"
                 Text="{Binding Status}"
                 TextAlignment="Center" />

      <Button MinWidth="96"
              Margin="0,20,0,0"
              HorizontalAlignment="Center"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CancelCommand}"
              Content="Cancel"
              Visibility="{Binding IsCancellable, Converter={StaticResource Converter.BooleanToVisibility}}" />
    </StackPanel>
  </Border>
</dialogs:DialogWindowBase>
