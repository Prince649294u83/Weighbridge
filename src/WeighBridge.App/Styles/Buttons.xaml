<!--
  Buttons.xaml
  The five button roles required by the design system: Primary, Secondary, Danger,
  Success and Text. Each is a keyed Style over the stock Button so any Button in
  any View can opt in without a custom control.

  All colours are DynamicResource so a runtime theme switch recolours them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Base template. A single Border with a ContentPresenter; visual states are driven
    by triggers that swap the Border background. Focus is drawn as an outer ring so
    keyboard users can always see where they are.
  -->
  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{StaticResource Thickness.Button}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!-- Focus ring sits outside the button body. -->
            <Border x:Name="FocusRing"
                    Margin="-3"
                    CornerRadius="{StaticResource Radius.MD.Focus}"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    Visibility="Collapsed" />

            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.MD}"
                    SnapsToDevicePixels="True">
              <ContentPresenter x:Name="Content"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.55" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Filled accent button. One per screen - the single most likely action.
  -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Disabled}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Outlined button for secondary actions (Cancel, Back, Reset). -->
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Destructive actions: delete, cancel a weighment, purge logs. -->
  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Default}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Confirming a completed operation: Save &amp; Print, Complete Weighment. -->
  <Style x:Key="Button.Success" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Success.Default}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Default}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Borderless, low-emphasis action. Reads as a link but behaves as a button. -->
  <Style x:Key="Button.Text" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Accent}" />
    <Setter Property="MinWidth" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Square icon-only button (toolbar, navigation rail toggle). Sized to the control
    height so it stays on the 8px grid.
  -->
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="Width" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Caption-bar buttons. Deliberately not rounded and 46px wide to match the Windows
     11 caption metrics, and Close gets its own red hover per the platform convention.
  -->
  <Style x:Key="Button.WindowControl" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Width" Value="{StaticResource Size.WindowButtonWidth}" />
    <Setter Property="Height" Value="{StaticResource Size.TitleBarHeight}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.WindowButton.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.WindowButton.Pressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.WindowControl.Close" TargetType="Button" BasedOn="{StaticResource Button.WindowControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.WindowButton.CloseHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.WindowButton.ClosePressed}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Unkeyed default so a bare <Button/> is never the raw Windows chrome. -->
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />

</ResourceDictionary>
