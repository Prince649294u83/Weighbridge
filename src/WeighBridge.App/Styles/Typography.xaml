<!--
  Typography.xaml
  Named text styles. Views must use these instead of setting FontSize/FontWeight
  inline, so that a future change to the type scale is a single-file edit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base: every text style inherits font family and rendering settings from here. -->
  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

  <Style x:Key="Text.Body.Wrapped" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Text.Secondary.Wrapped" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <!-- Uppercase group label, used above sections of the navigation panel. -->
  <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    <Setter Property="TextBlock.LineHeight" Value="16" />
  </Style>

  <!--
    Numeric readouts (weights, tickets, totals). Monospaced so digits do not shift
    horizontally as the value changes - important for a live weight display.
  -->
  <Style x:Key="Text.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
  </Style>

  <Style x:Key="Text.Numeric.Large" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Segoe Fluent Icons glyph. Content comes from Resources/Icons.xaml. -->
  <Style x:Key="Text.Icon" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Icon}" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Implicit style so text inside plain panels still picks up the design system. -->
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

</ResourceDictionary>
