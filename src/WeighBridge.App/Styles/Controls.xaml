<!--
  Controls.xaml
  Default styles and control templates for the custom controls in Controls/.

  Every control there calls DefaultStyleKeyProperty.OverrideMetadata, so each needs a
  Style keyed by its type. This dictionary is merged into App.xaml, which is where WPF
  finds it during default-style lookup - no Themes/Generic.xaml indirection, so the
  templates can use StaticResource against the tokens merged earlier in App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WeighBridge.App.Controls">

  <!--  ===================================================================
        ModernCard
        A rounded surface with an optional header row. The shadow is drawn by a
        sibling Border underneath rather than an Effect on the content Border,
        because an Effect applies to the whole subtree and would blur the text.
        ===================================================================  -->
  <Style x:Key="{x:Type controls:ModernCard}" TargetType="controls:ModernCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource Thickness.Card}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ModernCard">
          <Grid>
            <Border x:Name="Shadow"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource Radius.MD}"
                    Effect="{DynamicResource Elevation.Card}" />

            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.MD}"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderRow" Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock x:Name="HeaderIcon"
                             Grid.Column="0"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource Text.Icon}"
                             FontSize="{StaticResource Font.Size.IconLarge}"
                             Foreground="{DynamicResource Brush.Text.Accent}"
                             Text="{TemplateBinding Icon}" />

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{TemplateBinding Header}" />
                    <TextBlock x:Name="SubHeaderText"
                               Margin="0,2,0,0"
                               Style="{StaticResource Text.Secondary}"
                               Text="{TemplateBinding SubHeader}" />
                  </StackPanel>

                  <ContentPresenter x:Name="HeaderActionsHost"
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding HeaderActions}" />
                </Grid>

                <ContentPresenter Grid.Row="1"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </Border>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="HasShadow" Value="False">
              <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="">
              <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="SubHeader" Value="">
              <Setter TargetName="SubHeaderText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HeaderActions" Value="{x:Null}">
              <Setter TargetName="HeaderActionsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!--  No header text and no actions: the whole row disappears, padding included.  -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Header" Value="" />
                <Condition Property="HeaderActions" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ===================================================================
        StatusBadge
        Pill with an optional leading dot. Neutral is the default; the other four
        severities are applied by trigger so the caller only sets Severity.
        ===================================================================  -->
  <Style x:Key="{x:Type controls:StatusBadge}" TargetType="controls:StatusBadge">
    <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Neutral.Default}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:StatusBadge">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Radius.Pill}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="Dot"
                       Width="{StaticResource Size.StatusDot}"
                       Height="{StaticResource Size.StatusDot}"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center"
                       Fill="{TemplateBinding BorderBrush}" />
              <TextBlock VerticalAlignment="Center"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         FontWeight="{TemplateBinding FontWeight}"
                         Foreground="{TemplateBinding Foreground}"
                         Text="{TemplateBinding Text}" />
            </StackPanel>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="ShowDot" Value="False">
              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Severity" Value="Information">
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Default}" />
      </Trigger>
      <Trigger Property="Severity" Value="Success">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Default}" />
      </Trigger>
      <Trigger Property="Severity" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Default}" />
      </Trigger>
      <Trigger Property="Severity" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Default}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  ===================================================================
        SectionHeader
        ===================================================================  -->
  <Style x:Key="{x:Type controls:SectionHeader}" TargetType="controls:SectionHeader">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SectionHeader">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock x:Name="HeaderIcon"
                         Grid.Column="0"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource Text.Icon}"
                         FontSize="{StaticResource Font.Size.IconLarge}"
                         Foreground="{DynamicResource Brush.Text.Accent}"
                         Text="{TemplateBinding Icon}" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Title}" Text="{TemplateBinding Title}" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,4,0,0"
                           Style="{StaticResource Text.Secondary.Wrapped}"
                           Text="{TemplateBinding Description}" />
              </StackPanel>

              <ContentPresenter x:Name="ActionsHost"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Actions}" />
            </Grid>

            <Border x:Name="Separator"
                    Height="1"
                    Margin="0,16,0,0"
                    Background="{DynamicResource Brush.Border.Subtle}"
                    Visibility="Collapsed" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="">
              <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Actions" Value="{x:Null}">
              <Setter TargetName="ActionsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowSeparator" Value="True">
              <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ===================================================================
        NavigationItem
        Accessible bottom horizontal navigation item.
        Stacked vertical layout with large 26px glyph, high-contrast label,
        and top accent indicator bar for immediate visual recognition.
        ===================================================================  -->
  <Style x:Key="{x:Type controls:NavigationItem}" TargetType="controls:NavigationItem">
    <Setter Property="Height" Value="{StaticResource Size.BottomNavigationItemHeight}" />
    <Setter Property="Margin" Value="3,2" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:NavigationItem">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.MD}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Top Selection Indicator Bar -->
              <Border x:Name="SelectionBar"
                      Grid.Row="0"
                      Height="4"
                      Margin="16,0,16,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Background="{DynamicResource Brush.Accent.Default}"
                      CornerRadius="2"
                      Visibility="Hidden" />

              <!-- Main Content: Big Icon + Label Stack -->
              <Grid Grid.Row="1" Margin="4,2,4,4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid HorizontalAlignment="Center">
                    <TextBlock x:Name="Glyph"
                               FontSize="{StaticResource Font.Size.NavigationIcon}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Icon}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Icon}"
                               TextAlignment="Center" />

                    <!-- Floating Badge if present -->
                    <Border x:Name="Badge"
                            Margin="18,-4,-12,0"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Accent.Default}"
                            CornerRadius="{StaticResource Radius.Pill}">
                      <TextBlock FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{StaticResource Font.Size.Caption}"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Text.OnAccent}"
                                 Text="{TemplateBinding BadgeText}" />
                    </Border>
                  </Grid>

                  <TextBlock x:Name="LabelText"
                             Margin="0,3,0,0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Foreground="{TemplateBinding Foreground}"
                             Text="{TemplateBinding Label}"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="BadgeText" Value="">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="IsCollapsed" Value="True">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}" />
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Text.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderThickness" Value="2" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ===================================================================
        SearchBox
        ===================================================================  -->

  <!--
    The inner editor is stripped to nothing but the content host: the surrounding
    Border in the SearchBox template is the visible chrome. Without this the implicit
    TextBox style would draw a second, nested input box.
  -->
  <Style x:Key="SearchBox.Editor" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent.Default}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type controls:SearchBox}" TargetType="controls:SearchBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SearchBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.SM}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource Text.Icon}"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"
                         Text="{StaticResource Icon.Search}" />

              <Grid Grid.Column="1">
                <TextBlock x:Name="PlaceholderText"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.Text.Placeholder}"
                           Text="{TemplateBinding Placeholder}"
                           Visibility="Collapsed" />

                <TextBox x:Name="PART_TextBox"
                         Style="{StaticResource SearchBox.Editor}"
                         Text="{Binding SearchText,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        UpdateSourceTrigger=PropertyChanged}" />
              </Grid>

              <!--
                Both the placeholder and the clear button are driven by the single
                SearchText="" trigger below: each is declared here in its non-empty
                state, and the trigger flips it when the box is empty.
              -->
              <Button x:Name="PART_ClearButton"
                      Grid.Column="2"
                      Width="24"
                      Height="24"
                      MinWidth="0"
                      MinHeight="0"
                      Margin="6,0,0,0"
                      Padding="0"
                      VerticalAlignment="Center"
                      Style="{StaticResource Button.Icon}"
                      FontSize="{StaticResource Font.Size.Small}"
                      Content="{StaticResource Icon.Clear}"
                      ToolTip="Clear" />
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="SearchText" Value="">
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ===================================================================
        EmptyState
        ===================================================================  -->
  <Style x:Key="{x:Type controls:EmptyState}" TargetType="controls:EmptyState">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="Padding" Value="{StaticResource Thickness.XL}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:EmptyState">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="{TemplateBinding Padding}">
            <Border x:Name="IconRing"
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.Pill}">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Style="{StaticResource Text.Icon}"
                         FontSize="30"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"
                         Text="{TemplateBinding Icon}" />
            </Border>

            <TextBlock Margin="0,20,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.Subtitle}"
                       Text="{TemplateBinding Title}"
                       TextAlignment="Center" />

            <TextBlock x:Name="MessageText"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.Secondary.Wrapped}"
                       Text="{TemplateBinding Message}"
                       TextAlignment="Center" />

            <Button x:Name="ActionButton"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Button.Primary}"
                    Command="{TemplateBinding ActionCommand}"
                    Content="{TemplateBinding ActionText}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="">
              <Setter TargetName="IconRing" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Message" Value="">
              <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActionText" Value="">
              <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ===================================================================
        LoadingSpinner
        A dashed ring rotated by a storyboard. The storyboard only runs while
        IsActive is true, so a hidden spinner costs nothing per frame.
        ===================================================================  -->
  <Style x:Key="{x:Type controls:LoadingSpinner}" TargetType="controls:LoadingSpinner">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:LoadingSpinner">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}">
              <Ellipse Margin="2"
                       Stroke="{DynamicResource Brush.Border.Subtle}"
                       StrokeThickness="3" />

              <Ellipse x:Name="Arc"
                       Margin="2"
                       RenderTransformOrigin="0.5,0.5"
                       Stroke="{TemplateBinding Foreground}"
                       StrokeDashArray="9 26"
                       StrokeDashCap="Round"
                       StrokeThickness="3">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="ArcRotation" Angle="0" />
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.Secondary.Wrapped}"
                       Text="{TemplateBinding Message}"
                       TextAlignment="Center" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Message" Value="">
              <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="IsActive" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="SpinStoryboard">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ArcRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0"
                                     To="360"
                                     Duration="0:0:1.1"
                                     RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsActive" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
