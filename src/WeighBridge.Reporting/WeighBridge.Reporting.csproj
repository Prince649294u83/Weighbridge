<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WeighBridge.Reporting
    Report generation / export layer. Module 0.1 ships a placeholder that advertises
    the supported export formats without producing any output.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WeighBridge.Reporting</RootNamespace>
    <AssemblyName>WeighBridge.Reporting</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeighBridge.Core\WeighBridge.Core.csproj" />
    <ProjectReference Include="..\WeighBridge.Domain\WeighBridge.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
