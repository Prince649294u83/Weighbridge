<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WeighBridge.Infrastructure
    Persistence concerns: EF Core DbContext, migration infrastructure, generic
    repository/unit-of-work placeholders and the database health check.
    No domain tables are mapped in Module 0.1 — only the plumbing exists.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WeighBridge.Infrastructure</RootNamespace>
    <AssemblyName>WeighBridge.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeighBridge.Core\WeighBridge.Core.csproj" />
    <ProjectReference Include="..\WeighBridge.Domain\WeighBridge.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
